[Unit]
Description=OmniFleet MOLA pure-LIO localization
Wants=network-online.target airy-lidar-network.service omnifleet-t2-airy.service ackermann-stm32-chassis.service
After=network-online.target airy-lidar-network.service omnifleet-t2-airy.service ackermann-stm32-chassis.service

[Service]
Type=simple
User=iecme
Group=iecme
WorkingDirectory=/home/iecme/omnifleet_a2_ws
Environment=HOME=/home/iecme
Environment=ROS_HOME=/home/iecme/.ros
EnvironmentFile=/home/iecme/omnifleet_a2_ws/deploy/111-standard/config/robot.env
Environment="CMAKE_PREFIX_PATH=/home/iecme/omnifleet_a2_ws/install_111/mrpt_libros_bridge:/home/iecme/omnifleet_a2_ws/install_111/mrpt"
Environment="LD_LIBRARY_PATH=/opt/ros/humble/lib/aarch64-linux-gnu:/opt/ros/humble/lib:/home/iecme/omnifleet_a2_ws/install_111/mrpt_libros_bridge/lib:/home/iecme/omnifleet_a2_ws/install_111/mrpt/lib"
ExecStart=/bin/bash -lc 'source /home/iecme/omnifleet_a2_ws/src/system/workspace_support/robot_fleet_env.bash && exec ros2 launch omnifleet_bringup mola_localization.launch.py profile:=simple_direct start_chassis:=false map_dir:=/var/lib/omnifleet_a2/maps'
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
KillMode=mixed
TimeoutStartSec=90
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
