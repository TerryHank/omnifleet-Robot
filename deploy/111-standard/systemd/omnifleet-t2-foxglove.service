[Unit]
Description=OmniFleet Foxglove WebSocket bridge
After=network-online.target

[Service]
Type=simple
User=iecme
Group=iecme
WorkingDirectory=/home/iecme/omnifleet_a2_ws
Environment=HOME=/home/iecme
EnvironmentFile=/home/iecme/omnifleet_a2_ws/deploy/111-standard/config/robot.env
ExecStart=/bin/bash -lc 'source /home/iecme/omnifleet_a2_ws/src/system/workspace_support/robot_fleet_env.bash && exec ros2 run foxglove_bridge foxglove_bridge --ros-args -r __node:=omnifleet_t2_foxglove_bridge --params-file /home/iecme/omnifleet_a2_ws/deploy/111-standard/config/foxglove.yaml -p address:=$OMNIFLEET_T2_FOXGLOVE_ADDRESS -p port:=$OMNIFLEET_T2_FOXGLOVE_PORT'
Restart=always
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
