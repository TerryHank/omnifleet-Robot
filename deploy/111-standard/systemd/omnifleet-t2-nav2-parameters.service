[Unit]
Description=OmniFleet permanent Nav2 parameters
After=network-online.target

[Service]
Type=simple
User=iecme
Group=iecme
WorkingDirectory=/home/iecme/omnifleet_a2_ws
EnvironmentFile=/home/iecme/omnifleet_a2_ws/deploy/111-standard/config/robot.env
ExecStart=/bin/bash -lc 'source /home/iecme/omnifleet_a2_ws/src/system/workspace_support/robot_fleet_env.bash && exec python3 /home/iecme/omnifleet_a2_ws/src/visualization/omnifleet_t2_ws/foxglove/nav2_permanent_panel/nav2_parameter_store.py'
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
