[Unit]
Description=OmniFleet LAN identity broadcast (no motion commands)
After=network-online.target omnifleet-local-navigation.service
Wants=network-online.target

[Service]
User=iecme
Group=iecme
Type=simple
ExecStart=/usr/bin/python3 /home/iecme/omnifleet_a2_ws/deploy/111-standard/discovery/fleet_beacon.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
