[Unit]
Description=OmniFleet Ackermann Nav2 navigation
Requires=omnifleet-t2-mola.service ackermann-stm32-chassis.service
Wants=omnifleet-t2-foxglove.service
After=omnifleet-t2-mola.service ackermann-stm32-chassis.service omnifleet-t2-foxglove.service

[Service]
Type=simple
User=iecme
Group=iecme
WorkingDirectory=/home/iecme/omnifleet_a2_ws
Environment=HOME=/home/iecme
Environment=ROS_HOME=/home/iecme/.ros
EnvironmentFile=/home/iecme/omnifleet_a2_ws/deploy/111-standard/config/robot.env
Environment="CMAKE_PREFIX_PATH=/home/iecme/omnifleet_a2_ws/install_111/mrpt_libros_bridge:/home/iecme/omnifleet_a2_ws/install_111/mrpt"
Environment="LD_LIBRARY_PATH=/opt/ros/humble/lib/aarch64-linux-gnu:/opt/ros/humble/lib:/home/iecme/omnifleet_a2_ws/install_111/mrpt_libros_bridge/lib:/home/iecme/omnifleet_a2_ws/install_111/mrpt/lib"
ExecStart=/bin/bash -lc 'source /home/iecme/omnifleet_a2_ws/src/system/workspace_support/robot_fleet_env.bash && exec ros2 launch omnifleet_bringup navigation.launch.py transform_tolerance:=0.8 odom_topic:=/lidar_odometry/nav_odom obstacle_topic:=/navigation/deskewed_points obstacle_clearing:=true use_sim_time:=false autostart:=true params_file:=/home/iecme/omnifleet_a2_ws/install_111/omnifleet_planner/share/omnifleet_planner/config/nav2_glim.yaml'
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
KillMode=mixed
TimeoutStartSec=90
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
