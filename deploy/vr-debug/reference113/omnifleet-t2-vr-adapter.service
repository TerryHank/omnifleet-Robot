[Unit]
Description=OmniFleet T2 VR protocol and servo adapter
After=network-online.target omnifleet-t2-chassis.service
Wants=network-online.target

[Service]
Type=simple
User=iecme
Group=iecme
WorkingDirectory=/home/iecme/omnifleet_ws
Environment=HOME=/home/iecme
Environment=PYTHONUNBUFFERED=1
Environment=ROS_DOMAIN_ID=0
ExecStart=/bin/bash -lc 'source /home/iecme/omnifleet_ws/src/system/workspace_support/robot_fleet_env.bash && exec ros2 run omnifleet_bringup vr_protocol_adapter --ros-args -p car_id:=CAR-IECME113 -p car_name:=OmniFleet-Tracked-Airy -p enable_drive:=false -p camera_topic:=/camera/color/image_raw/compressed'
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
