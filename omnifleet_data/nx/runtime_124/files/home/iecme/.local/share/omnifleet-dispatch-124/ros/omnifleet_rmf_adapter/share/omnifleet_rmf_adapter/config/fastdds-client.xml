<?xml version="1.0" encoding="UTF-8"?>
<dds>
  <profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>omni-loopback</transport_id>
        <type>UDPv4</type>
        <sendBufferSize>10485760</sendBufferSize>
        <receiveBufferSize>10485760</receiveBufferSize>
        <maxMessageSize>65500</maxMessageSize>
        <maxInitialPeersRange>72</maxInitialPeersRange>
        <interfaceWhiteList><address>127.0.0.1</address></interfaceWhiteList>
      </transport_descriptor>
      <transport_descriptor>
        <transport_id>omni-shm</transport_id>
        <type>SHM</type>
        <segment_size>12582912</segment_size>
        <port_queue_capacity>512</port_queue_capacity>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="omni-local-participant" is_default_profile="true">
      <rtps>
        <builtin>
          <metatrafficUnicastLocatorList>
            <locator><udpv4><address>127.0.0.1</address></udpv4></locator>
          </metatrafficUnicastLocatorList>
          <initialPeersList>
            <locator><udpv4><address>127.0.0.1</address><port>0</port></udpv4></locator>
          </initialPeersList>
        </builtin>
        <userTransports>
          <transport_id>omni-loopback</transport_id>
          <transport_id>omni-shm</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
    <publisher profile_name="omni-default-writer" is_default_profile="true">
      <qos>
        <publishMode><kind>SYNCHRONOUS</kind></publishMode>
        <data_sharing><kind>OFF</kind></data_sharing>
      </qos>
      <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
    </publisher>
    <subscriber profile_name="omni-default-reader" is_default_profile="true">
