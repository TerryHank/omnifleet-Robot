[Unit]
Description=OmniFleet 124 Fast DDS TCP discovery link
After=network-online.target omnifleet-124-rmf-navigation.service
Wants=network-online.target
[Service]
User=iecme
RuntimeDirectory=omnifleet-124-ddsrouter
RuntimeDirectoryMode=0755
Environment=LD_LIBRARY_PATH=/home/iecme/.local/share/omnifleet-dispatch-124/ddsrouter-runtime/lib
ExecStartPre=/usr/bin/python3 /home/iecme/.local/share/omnifleet-dispatch-124/omnifleet-fastdds-lan-config
ExecStart=/home/iecme/.local/share/omnifleet-dispatch-124/ddsrouter-runtime/bin/ddsrouter -c /run/omnifleet-124-ddsrouter/ddsrouter.yaml
Restart=on-failure
RestartSec=3
Nice=4
[Install]
WantedBy=multi-user.target
