[Unit]
Description=OmniFleet onboard dispatch %i
PartOf=omnifleet-onboard-dispatch.target
After=network.target

[Service]
User=iecme
WorkingDirectory=/home/iecme/omnifleet_ws
ExecStart=/bin/bash /home/iecme/omnifleet_ws/src/system/omnifleet_rmf_adapter/scripts/run.bash %i
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=12
Nice=4
