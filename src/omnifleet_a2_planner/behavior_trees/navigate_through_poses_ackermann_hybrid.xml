<!-- Keep a valid multi-pose path; otherwise try forward before reverse fallback. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <PipelineSequence name="NavigateWithReplanning">
      <RateController hz="1.0">
        <Fallback name="KeepValidPath">
          <IsPathValid path="{path}"/>
          <ReactiveSequence name="PlanThroughRemainingPoses">
            <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="0.20"/>
            <Fallback name="PlanForwardThenReverse">
              <Sequence name="PlanAndValidateForward">
                <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="ForwardGrid"/>
                <IsPathValid path="{path}"/>
              </Sequence>
              <Sequence name="PlanAndValidateReverse">
                <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
                <IsPathValid path="{path}"/>
              </Sequence>
            </Fallback>
          </ReactiveSequence>
        </Fallback>
      </RateController>
      <RecoveryNode number_of_retries="1" name="FollowPathWithLocalCostmapClear">
        <FollowPath path="{path}" controller_id="FollowPath"/>
        <ClearEntireCostmap name="ClearLocalCostmapAfterControllerFailure" service_name="local_costmap/clear_entirely_local_costmap"/>
      </RecoveryNode>
    </PipelineSequence>
  </BehaviorTree>
</root>
