      "followMode": "follow-pose",
      "cameraState": {
        "perspective": false,
        "distance": 8,
        "phi": 0.01,
        "thetaOffset": 0,
        "target": [
          0,
          0,
          0
        ],
        "targetOffset": [
          0.3,
          0.7,
          0
