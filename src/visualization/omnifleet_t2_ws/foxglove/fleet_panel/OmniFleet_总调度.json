      "showLegend": true,
      "legendDisplay": "top",
      "showPlotValuesInLegend": true,
      "followingViewWidth": 30,
      "xAxisVal": "timestamp",
      "isSynced": true
    },
    "Plot!104": {
      "foxglovePanelTitle": "robot_104 指令 / 实测线速度",
