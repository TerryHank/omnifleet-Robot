<?xml version="1.0"?>
<sdf version="1.6">
  <world name="omnifleet_a2_traffic_sandbox">
    <physics type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_update_rate>500</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
      <ode><solver><type>quick</type><iters>50</iters></solver></ode>
    </physics>
    <gravity>0 0 -9.80665</gravity>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.72 0.82 0.92 1</background>
      <shadows>true</shadows>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- Official TurtleBot3 AutoRace texture, enlarged 3x for the A2 Ackermann chassis. -->
    <include>
      <uri>model://turtlebot3_autorace_2020/course</uri>
      <name>autorace_road_course</name>
      <pose>0 0 0.001 0 0 3.14159265359</pose>
      <scale>3 3 3</scale>
    </include>

    <!-- Traffic-light intersection and road signs. -->
    <include><uri>model://turtlebot3_autorace_2020/traffic_light</uri><name>traffic_light_intersection</name><pose>3.9 -5.45 0.31 0 0 -1.57</pose><scale>2.5 2.5 2.5</scale></include>
    <include><uri>model://turtlebot3_autorace_2020/traffic_intersection</uri><name>intersection_sign</name><pose>5.45 -3.0 0.31 0 0 0</pose><scale>2.5 2.5 2.5</scale></include>
    <include><uri>model://turtlebot3_autorace_2020/traffic_stop</uri><name>stop_sign</name><pose>-4.05 3.12 0.31 0 0 -1.57</pose><scale>2.5 2.5 2.5</scale></include>
    <include><uri>model://turtlebot3_autorace_2020/traffic_noentry</uri><name>no_entry_sign</name><pose>2.85 -2.27 0.31 0 0 0</pose><scale>2.5 2.5 2.5</scale></include>
    <include><uri>model://turtlebot3_autorace_2020/traffic_left</uri><name>left_turn_sign</name><pose>-5.35 -3.45 0.31 0 0 1.57</pose><scale>2.5 2.5 2.5</scale></include>
    <include><uri>model://turtlebot3_autorace_2020/traffic_right</uri><name>right_turn_sign</name><pose>3.24 -2.18 0.31 0 0 -1.57</pose><scale>2.5 2.5 2.5</scale></include>

    <!-- Parking scene and finish checker. -->
    <include><uri>model://turtlebot3_autorace_2020/traffic_parking</uri><name>parking_sign</name><pose>2.22 5.45 0.31 0 0 -1.57</pose><scale>2.5 2.5 2.5</scale></include>
    <include><uri>model://turtlebot3_autorace_2020/checker</uri><name>finish_checker</name><pose>4.8 -5.2 0.02 0 0 0</pose><scale>2.5 2.5 2.5</scale></include>

    <!-- Construction signs and a partially occupied lane. -->
    <include><uri>model://turtlebot3_autorace_2020/traffic_construction</uri><name>construction_sign</name><pose>3.0 0.12 0.31 0 0 -1.57</pose><scale>2.5 2.5 2.5</scale></include>
    <include><uri>model://turtlebot3_autorace_2020/traffic_bar</uri><name>barrier_sign</name><pose>-2.4 3.78 0.31 0 0 -1.57</pose><scale>2.5 2.5 2.5</scale></include>

    <!-- Tunnel sign plus a traversable 1.2 m-wide tunnel. -->
    <include><uri>model://turtlebot3_autorace_2020/traffic_tunnel</uri><name>tunnel_sign</name><pose>-4.63 0 0.31 0 0 0</pose><scale>2.5 2.5 2.5</scale></include>
    <model name="traffic_tunnel_structure">
      <static>true</static>
      <link name="link">
        <collision name="left_wall"><pose>-0.66 0 0.45 0 0 0</pose><geometry><box><size>0.12 3.0 0.9</size></box></geometry></collision>
        <collision name="right_wall"><pose>0.66 0 0.45 0 0 0</pose><geometry><box><size>0.12 3.0 0.9</size></box></geometry></collision>
        <collision name="roof"><pose>0 0 0.96 0 0 0</pose><geometry><box><size>1.44 3.0 0.12</size></box></geometry></collision>
        <visual name="left_wall_visual"><pose>-0.66 0 0.45 0 0 0</pose><geometry><box><size>0.12 3.0 0.9</size></box></geometry><material><ambient>0.25 0.28 0.32 1</ambient><diffuse>0.35 0.38 0.42 1</diffuse></material></visual>
        <visual name="right_wall_visual"><pose>0.66 0 0.45 0 0 0</pose><geometry><box><size>0.12 3.0 0.9</size></box></geometry><material><ambient>0.25 0.28 0.32 1</ambient><diffuse>0.35 0.38 0.42 1</diffuse></material></visual>
        <visual name="roof_visual"><pose>0 0 0.96 0 0 0</pose><geometry><box><size>1.44 3.0 0.12</size></box></geometry><material><ambient>0.18 0.20 0.24 1</ambient><diffuse>0.28 0.30 0.34 1</diffuse></material></visual>
      </link>
      <pose>-4.1 0 0 0 0 0</pose>
    </model>

    <!-- Parked vehicles become static planning obstacles. -->
    <model name="parked_vehicle_blue">
      <static>true</static><pose>1.55 4.55 0.22 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.72 0.38 0.44</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.72 0.38 0.44</size></box></geometry><material><ambient>0.05 0.25 0.75 1</ambient><diffuse>0.08 0.35 0.9 1</diffuse></material></visual></link>
    </model>
    <model name="parked_vehicle_yellow">
      <static>true</static><pose>2.55 4.55 0.22 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.72 0.38 0.44</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.72 0.38 0.44</size></box></geometry><material><ambient>0.85 0.55 0.05 1</ambient><diffuse>0.95 0.68 0.08 1</diffuse></material></visual></link>
    </model>

    <!-- Four low orange blocks emulate cones without a custom physics plugin. -->
    <model name="construction_blocks">
      <static>true</static><pose>2.4 0.1 0 0 0 0</pose>
      <link name="link">
        <collision name="c1"><pose>0 0 0.16 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.32</length></cylinder></geometry></collision>
        <collision name="c2"><pose>0.65 0.35 0.16 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.32</length></cylinder></geometry></collision>
        <visual name="v1"><pose>0 0 0.16 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.32</length></cylinder></geometry><material><ambient>1 0.25 0.02 1</ambient><diffuse>1 0.35 0.03 1</diffuse></material></visual>
        <visual name="v2"><pose>0.65 0.35 0.16 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.32</length></cylinder></geometry><material><ambient>1 0.25 0.02 1</ambient><diffuse>1 0.35 0.03 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Low perimeter is represented in both Gazebo and /map. -->
    <model name="course_boundary">
      <static>true</static>
      <link name="link">
        <collision name="north"><pose>0 5.95 0.2 0 0 0</pose><geometry><box><size>12 0.1 0.4</size></box></geometry></collision>
        <collision name="south"><pose>0 -5.95 0.2 0 0 0</pose><geometry><box><size>12 0.1 0.4</size></box></geometry></collision>
        <collision name="east"><pose>5.95 0 0.2 0 0 0</pose><geometry><box><size>0.1 12 0.4</size></box></geometry></collision>
        <collision name="west"><pose>-5.95 0 0.2 0 0 0</pose><geometry><box><size>0.1 12 0.4</size></box></geometry></collision>
        <visual name="north_v"><pose>0 5.95 0.2 0 0 0</pose><geometry><box><size>12 0.1 0.4</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
        <visual name="south_v"><pose>0 -5.95 0.2 0 0 0</pose><geometry><box><size>12 0.1 0.4</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
        <visual name="east_v"><pose>5.95 0 0.2 0 0 0</pose><geometry><box><size>0.1 12 0.4</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
        <visual name="west_v"><pose>-5.95 0 0.2 0 0 0</pose><geometry><box><size>0.1 12 0.4</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
      </link>
    </model>
  </world>
</sdf>
