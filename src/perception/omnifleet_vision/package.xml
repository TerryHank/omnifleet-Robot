<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>omnifleet_vision</name>
  <version>0.3.0</version>
  <description>Reusable ROS 2 vision nodes for OmniFleet teaching workflows.</description>
  <maintainer email="iecme@example.com">iecme</maintainer>
  <license>MIT</license>
  <license>BSD-3-Clause</license>
  <license>LicenseRef-Original-KCF-Research-Terms</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>cv_bridge</depend>
  <depend>geometry_msgs</depend>
  <depend>libopencv-dev</depend>
  <depend>message_filters</depend>
  <depend>nlohmann_json</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-pyzbar</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>tesseract-ocr</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <exec_depend>image_transport</exec_depend>
  <exec_depend>compressed_image_transport</exec_depend>
  <exec_depend>omnifleet_person_follow</exec_depend>
  <exec_depend>omnifleet_hikrobot_rgbd</exec_depend>
  <exec_depend>orbbec_camera_msgs</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
