  rclcpp::Subscription<std_msgs::msg::String>::SharedPtr external_sub_;
  bool remote_roi_ = false;
  int image_height_ = 0;
  std::optional<sensor_msgs::msg::RegionOfInterest> pending_roi_;
  rclcpp::Subscription<sensor_msgs::msg::RegionOfInterest>::SharedPtr roi_sub_;
  bool sparse_depth_ = false;
  bool inline_sparse_depth_ = false;
  rclcpp::Publisher<sensor_msgs::msg::Range>::SharedPtr inline_range_pub_;
  rclcpp::Publisher<std_msgs::msg::String>::SharedPtr inline_targets_pub_;
  bool aligning_ = false;
  int image_width_ = 0;
  int target_id_ = 0;
  double tracking_epoch_ = 0.0;
  double last_linear_ = 0.0, last_angular_ = 0.0;
  std::string motion_state_ = "LOST";
  rclcpp::Publisher<std_msgs::msg::String>::SharedPtr status_pub_;
  rclcpp::Subscription<sensor_msgs::msg::Range>::SharedPtr sparse_depth_sub_;
  std::string tracker_color_topic_;
  std::string aligned_color_topic_;
  std::string depth_topic_;
  std::string output_image_topic_;
  std::string cmd_vel_topic_;
  bool enable_motion_;
  bool use_gui_;
  double tracking_scale_;
  int tracking_max_width_;
  int sync_queue_size_;
  double max_pair_delta_;
  double tracking_timeout_;
