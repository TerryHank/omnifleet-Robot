#!/usr/bin/env python3
"""根据带深度的目标结果生成安全跟随候选速度。"""

import json
import math
from pathlib import Path

import rclpy
from geometry_msgs.msg import Twist
from rclpy.node import Node
from rclpy.parameter import Parameter
from rcl_interfaces.msg import SetParametersResult
from std_msgs.msg import String

from course_controllers_core import target_follow_command
from standoff_strategy import StandoffStrategy


class TargetFollowControllerNode(Node):
    """支持颜色、行人或通用物体目标，默认禁止运动。"""

    def __init__(self) -> None:
        super().__init__("target_follow_controller")
        target_topic = self.declare_parameter("target_topic", "/vision/targets_3d").value
        command_topic = self.declare_parameter("command_topic", "/cmd_vel_vision").value
        status_topic = self.declare_parameter("status_topic", "/vision/target_follow/status").value
        if command_topic != "/cmd_vel_vision":
            raise ValueError("目标跟随只能发布 /cmd_vel_vision")
        self.use_standoff = bool(self.declare_parameter("use_standoff", False).value)
        self.enable_motion = bool(self.declare_parameter("enable_motion", False).value)
        self.timeout = float(self.declare_parameter("target_timeout", 0.8).value)
        self.image_width = float(self.declare_parameter("image_width", 1536.0).value)
        self.target_distance = float(self.declare_parameter("target_distance", 0.8).value)
        self.distance_file = Path.home()/'.config/omnifleet'/('follow_distance_'+self.get_name())
        self.distance_persistent = False
        try:
            saved_distance = float(self.distance_file.read_text())
            if math.isfinite(saved_distance) and saved_distance > 0.:
                self.target_distance = saved_distance
                self.set_parameters([Parameter('target_distance', value=saved_distance)])
                self.distance_persistent = True
        except (OSError, ValueError):
            pass
        self.distance_deadband = float(self.declare_parameter("distance_deadband", 0.15).value)
        self.linear_speed = float(self.declare_parameter("linear_speed", 0.4).value)
        self.angular_gain = float(self.declare_parameter("angular_gain", 0.6).value)
        self.max_angular_speed = float(self.declare_parameter("max_angular_speed", 0.3).value)
        self.class_filter = str(self.declare_parameter("class_filter", "").value)
        self.lock_timeout = float(self.declare_parameter("lock_timeout", 1.5).value)
        hysteresis = float(self.declare_parameter("distance_hysteresis", .05).value)
        rate = float(self.declare_parameter("control_rate", 10.0).value)
        if min(self.timeout, self.image_width, self.target_distance, self.distance_deadband, rate) <= 0.0:
            raise ValueError("目标跟随的距离、超时和频率参数必须大于零")
        if self.linear_speed < 0.0 or self.max_angular_speed < 0.0:
            raise ValueError("速度参数不能为负数")
        self.result = (0., 0., "target_lost", {"motion_state": "LOST"})
        self.payload = None
        self.last_target_time = None
        self.strategy = StandoffStrategy(
            target_distance=self.target_distance, deadband=self.distance_deadband,
            hysteresis=hysteresis, lock_timeout=self.lock_timeout, image_width=self.image_width,
            linear_speed=self.linear_speed, angular_gain=self.angular_gain,
            max_angular_speed=self.max_angular_speed)
        self.command_publisher = self.create_publisher(Twist, command_topic, 10)
        self.status_publisher = self.create_publisher(String, status_topic, 10)
        self.subscription = self.create_subscription(String, target_topic, self.on_target, 10)
        self.timer = self.create_timer(1.0 / rate, self.on_timer)
        self.parameter_callback = self.add_on_set_parameters_callback(self.on_parameters)

    def on_parameters(self, parameters):
        motion, distance, selected = self.enable_motion, self.target_distance, self.class_filter
        for parameter in parameters:
            if parameter.name == "enable_motion":
                if parameter.type_ != Parameter.Type.BOOL:
                    return SetParametersResult(successful=False, reason="enable_motion must be bool")
                motion = parameter.value
            elif parameter.name == "target_distance":
                if parameter.type_ != Parameter.Type.DOUBLE or not math.isfinite(parameter.value) or parameter.value <= 0.:
                    return SetParametersResult(successful=False, reason="target_distance must be finite and positive")
                distance = parameter.value
            elif parameter.name == "class_filter":
                if parameter.type_ != Parameter.Type.STRING:
                    return SetParametersResult(successful=False, reason="class_filter must be string")
                selected = parameter.value.strip().lower()
        if any(parameter.name == 'target_distance' for parameter in parameters):
            try:
                self.distance_file.parent.mkdir(parents=True, exist_ok=True)
                temporary = self.distance_file.with_suffix('.tmp')
                temporary.write_text(format(distance, '.17g')+'\n')
                temporary.replace(self.distance_file)
                self.distance_persistent = True
            except OSError as error:
                return SetParametersResult(successful=False, reason='Unable to save target_distance: '+str(error))
        if selected != self.class_filter:
            self.class_filter = selected
            self.strategy.locked_id = self.strategy.locked_class = None
            self.strategy.last_bbox = self.strategy.last_seen = None
            self.payload, self.last_target_time = None, None
            self.result = self.strategy.stop("color_changed")
            self.command_publisher.publish(Twist())
        if distance != self.target_distance:
            self.target_distance = self.strategy.target_distance = distance
            self.strategy.distance_state = 0
            if self.use_standoff and self.payload is not None and self.last_target_time is not None:
                if self.now_seconds()-self.last_target_time <= self.timeout:
                    self.result = self.strategy.update(self.payload, self.last_target_time, self.class_filter)
                else:
                    self.result = self.strategy.stop("target_timeout")
        if self.enable_motion and not motion:
            self.command_publisher.publish(Twist())
        self.enable_motion = motion
        return SetParametersResult(successful=True)

    def now_seconds(self) -> float:
        """返回 ROS 时钟秒数。"""

        return self.get_clock().now().nanoseconds / 1.0e9

    def on_target(self, message: String) -> None:
        """缓存最近的三维目标。"""

        try:
            payload = json.loads(message.data)
        except json.JSONDecodeError:
            return
        if isinstance(payload, dict):
            self.payload = payload
            self.last_target_time = self.now_seconds()
            if self.use_standoff:
                self.result = self.strategy.update(payload, self.last_target_time, self.class_filter)

    def on_timer(self) -> None:
        """定频发布跟随候选和状态。"""

        now = self.now_seconds()
        if self.use_standoff:
            if self.last_target_time is None or now - self.last_target_time > self.timeout:
                self.result = self.strategy.stop("target_timeout")
            linear, angular, reason, strategy_status = self.result
            if not self.enable_motion:
                linear, angular, reason = 0., 0., "motion_disabled"
        else:
            linear, angular, reason = target_follow_command(
                self.payload, self.enable_motion, now, self.last_target_time, self.timeout,
                self.image_width, self.target_distance, self.distance_deadband, self.linear_speed,
                self.angular_gain, self.max_angular_speed, self.class_filter)
            strategy_status = {}
        command = Twist()
        command.linear.x = linear
        command.angular.z = angular
        self.command_publisher.publish(command)
        status = String()
        status.data = json.dumps(
            {"stamp": now, "linear_x": linear, "angular_z": angular, "reason": reason,
             "strategy": "locked_target_standoff_hysteresis" if self.use_standoff else "legacy", **strategy_status,
             "enable_motion": self.enable_motion, "target_distance_m": self.target_distance,
             "distance_persistent": self.distance_persistent,
             "depth_m": strategy_status.get("distance_m"), "class_filter": self.class_filter,
             "locked_class": self.strategy.locked_class if self.use_standoff else None},
            ensure_ascii=False,
            separators=(",", ":"),
        )
        self.status_publisher.publish(status)

    def destroy_node(self):
        """退出前发布零速。"""

        self.command_publisher.publish(Twist())
        return super().destroy_node()


def main(args=None) -> None:
    """启动目标跟随控制器。"""

    rclpy.init(args=args)
    node = TargetFollowControllerNode()
    try:
        rclpy.spin(node)
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
