planner_server:
  ros__parameters:
    use_sim_time: false
    expected_planner_frequency: 1.0
    planner_plugins:
    - GridBased
    - GridNavFn
    - GridThetaStar
    - GridHybrid
    - GridLattice
    GridBased:
      plugin: omnifleet_planner::CostAwareSmac2D
      tolerance: 0.0
      downsample_costmap: false
      downsampling_factor: 1
      allow_unknown: true
      max_iterations: 1000000
      max_on_approach_iterations: 1000
      max_planning_time: 3.0
      cost_travel_multiplier: 6.0
      use_final_approach_orientation: false
      smoother:
        max_iterations: 1000
        w_smooth: 0.15
        w_data: 0.4
        tolerance: 1.0e-10
        do_refinement: true
    GridNavFn:
      plugin: nav2_navfn_planner/NavfnPlanner
      tolerance: 0.2
      use_astar: true
      allow_unknown: false
      use_final_approach_orientation: false
    GridThetaStar:
      plugin: nav2_theta_star_planner/ThetaStarPlanner
      how_many_corners: 8
      w_euc_cost: 1.0
      w_traversal_cost: 2.0
      allow_unknown: false
      use_final_approach_orientation: true
    GridHybrid:
      motion_model_for_search: REEDS_SHEPP
      minimum_turning_radius: 0.4
      reverse_penalty: 1.0
      change_penalty: 0.0
      non_straight_penalty: 1.2
      cost_penalty: 2.0
      angle_quantization_bins: 72
      analytic_expansion_ratio: 3.5
      analytic_expansion_max_length: 3.0
      tolerance: 0.25
      max_planning_time: 3.0
      allow_unknown: false
      smooth_path: true
      plugin: nav2_smac_planner/SmacPlannerHybrid
    GridLattice:
      plugin: omnifleet_planner::ExactGoalSmacLattice
      lattice_filepath: /home/iecme/omnifleet_ws/src/planning/omnifleet_planner/config/lattice/diff_10cm_r04.json
      tolerance: 0.2
      allow_unknown: true
      max_iterations: 1000000
      max_on_approach_iterations: 1000
      max_planning_time: 3.0
      allow_reverse_expansion: true
      reverse_penalty: 1.0
      change_penalty: 0.2
      non_straight_penalty: 1.05
      cost_penalty: 2.0
      rotation_penalty: 2.0
      retrospective_penalty: 0.015
      analytic_expansion_ratio: 3.5
      analytic_expansion_max_length: 0.1
      lookup_table_size: 20.0
      cache_obstacle_heuristic: false
      smooth_path: false
      smoother:
        max_iterations: 1000
        w_smooth: 0.3
        w_data: 0.2
        tolerance: 1.0e-10
        do_refinement: true
behavior_server:
  ros__parameters:
    use_sim_time: false
    costmap_topic: local_costmap/costmap_raw
    footprint_topic: local_costmap/published_footprint
    cycle_frequency: 10.0
    behavior_plugins:
    - spin
    - backup
    - drive_on_heading
    - wait
    spin:
      plugin: nav2_behaviors/Spin
    backup:
      plugin: nav2_behaviors/BackUp
    drive_on_heading:
      plugin: nav2_behaviors/DriveOnHeading
    wait:
      plugin: nav2_behaviors/Wait
    global_frame: map
    robot_base_frame: base_link
    transform_tolerance: 0.3
    simulate_ahead_time: 2.0
    max_rotational_vel: 0.15
    min_rotational_vel: 0.05
    rotational_acc_lim: 0.3
