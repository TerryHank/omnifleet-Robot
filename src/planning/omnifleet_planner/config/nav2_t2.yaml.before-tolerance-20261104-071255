controller_server:
  ros__parameters:
    use_sim_time: false
    controller_frequency: 15.0
    min_x_velocity_threshold: 0.001
    min_y_velocity_threshold: 0.5
    min_theta_velocity_threshold: 0.001
    failure_tolerance: 0.5
    progress_checker_plugin: progress_checker
    goal_checker_plugins:
    - general_goal_checker
    - continuous_goal_checker
    - fleet_goal_checker
    - native_continuous_goal_checker
    controller_plugins:
    - FollowPath
    - FollowPathRPP
    - FollowPathMPPI
    - FleetMPPI
    progress_checker:
      plugin: omnifleet_planner::NoProgressChecker
      required_movement_radius: 0.1
      required_movement_angle: 0.1
      movement_time_allowance: 10.0
    native_continuous_goal_checker:
      plugin: omnifleet_planner::NativeContinuousGoalChecker
    general_goal_checker:
      plugin: omnifleet_planner::FootprintSafeGoalChecker
      stateful: true
      xy_goal_tolerance: 0.08
      yaw_goal_tolerance: 0.35
      safe_hold_time: 0.35
    continuous_goal_checker:
      plugin: omnifleet_planner::FootprintSafeGoalChecker
      stateful: true
      xy_goal_tolerance: 0.08
      yaw_goal_tolerance: 0.35
      safe_hold_time: 0.35
      require_ordered_waypoints: true
    fleet_goal_checker:
      plugin: omnifleet_planner::FootprintSafeGoalChecker
      stateful: false
      xy_goal_tolerance: 0.08
      yaw_goal_tolerance: 0.25
      safe_hold_time: 0.35
    FollowPath:
      plugin: omnifleet_dwb_hot::HotDWBLocalPlanner
      debug_trajectory_details: false
      min_vel_x: 0.0
      min_vel_y: 0.0
      max_vel_x: 0.5
      max_vel_y: 0.0
      max_vel_theta: 1.2
      min_speed_xy: 0.2
      max_speed_xy: 0.5
      min_speed_theta: 0.6
      acc_lim_x: 0.8
      acc_lim_y: 0.0
      acc_lim_theta: 1.5
      decel_lim_x: -0.8
      decel_lim_y: 0.0
      decel_lim_theta: -1.5
      vx_samples: 20
      vy_samples: 1
      vtheta_samples: 40
      sim_time: 1.7
      linear_granularity: 0.05
      angular_granularity: 0.025
      transform_tolerance: 0.3
      xy_goal_tolerance: 0.2
      trans_stopped_velocity: 0.05
      short_circuit_trajectory_evaluation: true
      stateful: true
      critics:
      - ObstacleFootprint
      - RotateToGoal
      - Oscillation
      - BaseObstacle
      - GoalAlign
      - PathAlign
      - PathDist
      - GoalDist
      ObstacleFootprint.scale: 1.0
      BaseObstacle.scale: 0.5
      PathAlign.scale: 100.0
      PathAlign.forward_point_distance: 0.1
      GoalAlign.scale: 24.0
      GoalAlign.forward_point_distance: 0.1
      PathDist.scale: 100.0
      GoalDist.scale: 24.0
      RotateToGoal.scale: 70.0
      RotateToGoal.slowing_factor: 5.0
      RotateToGoal.lookahead_time: -1.0
    FollowPathRPP:
      plugin: omnifleet_planner::HotRegulatedPurePursuitController
      desired_linear_vel: 0.3
      lookahead_dist: 0.5
      min_lookahead_dist: 0.15
      max_lookahead_dist: 0.3
      lookahead_time: 1.5
      rotate_to_heading_angular_vel: 1.8
      transform_tolerance: 0.3
      use_velocity_scaled_lookahead_dist: false
      min_approach_linear_velocity: 0.05
      approach_velocity_scaling_dist: 0.4
      use_collision_detection: true
      max_allowed_time_to_collision_up_to_carrot: 1.0
      use_regulated_linear_velocity_scaling: true
      use_cost_regulated_linear_velocity_scaling: true
      regulated_linear_scaling_min_radius: 0.9
      regulated_linear_scaling_min_speed: 0.05
      use_rotate_to_heading: true
      rotate_to_heading_min_angle: 0.15
      max_angular_accel: 3.2
      max_robot_pose_search_dist: 10.0
      use_interpolation: true
      cost_scaling_dist: 0.3
      cost_scaling_gain: 1.0
      inflation_cost_scaling_factor: 3.0
      allow_reversing: false
      follow_gap_gain: 1.0
      follow_speed_damping: 1.0
    FollowPathMPPI:
      plugin: omnifleet_planner::PoseRotationShim
      primary_controller: nav2_mppi_controller::MPPIController
      angular_dist_threshold: 0.35
      angular_disengage_threshold: 0.15
      forward_sampling_distance: 0.15
      rotate_to_heading_angular_vel: 1.0
      max_angular_accel: 1.5
      simulate_ahead_time: 0.8
      rotate_to_goal_heading: true
      closed_loop: true
      rotation_center_offset_x: 0.055
      rotation_center_offset_y: -0.01
      time_steps: 56
      model_dt: 0.0666667
      batch_size: 500
      vx_std: 0.2
      vy_std: 0.2
      wz_std: 0.4
      vx_max: 0.35
      vx_min: -0.35
      vy_max: 0.0
      wz_max: 2.0
      ax_max: 0.8
      ax_min: -0.8
      ay_max: 0.0
      ay_min: 0.0
      az_max: 1.5
      iteration_count: 1
      prune_distance: 1.7
      enforce_path_inversion: false
      transform_tolerance: 0.3
      temperature: 0.3
      gamma: 0.015
      motion_model: DiffDrive
      visualize: false
      TrajectoryVisualizer:
        trajectory_step: 1000
        time_step: 5
      reset_period: 1.0
      critics:
      - ConstraintCritic
      - VelocityDeadbandCritic
      - CostCritic
      - FootprintClearanceCritic
      - FollowVelocityCritic
      - GoalCritic
      - GoalAngleCritic
      - PathAlignCritic
      - PathFollowCritic
      - PathAngleCritic
      - PreferForwardCritic
      VelocityDeadbandCritic:
        enabled: true
        cost_power: 1
        cost_weight: 1.0
        deadband_velocities: [0.2, 0.0, 0.2]
      ConstraintCritic:
        enabled: true
        cost_power: 1
        cost_weight: 4.0
      CostCritic:
        enabled: true
        cost_power: 1
        cost_weight: 6.0
        critical_cost: 300.0
        consider_footprint: true
        near_goal_distance: 0.15
      FootprintClearanceCritic:
        enabled: true
        cost_weight: 6.0
        desired_clearance: 0.10
      FollowVelocityCritic:
        cost_weight: 30.0
      GoalCritic:
        enabled: true
        cost_power: 1
        cost_weight: 10.0
        threshold_to_consider: 0.6
      GoalAngleCritic:
        enabled: true
        cost_power: 1
        cost_weight: 3.0
        threshold_to_consider: 0.08
      PathAlignCritic:
        enabled: true
        cost_power: 1
        cost_weight: 8.0
        threshold_to_consider: 0.08
        use_path_orientations: true
        offset_from_furthest: 5
      PathFollowCritic:
        enabled: true
        cost_power: 1
        cost_weight: 8.0
        threshold_to_consider: 0.08
      PathAngleCritic:
        enabled: true
        cost_power: 1
        cost_weight: 10.0
        threshold_to_consider: 0.08
        forward_preference: false
      PreferForwardCritic:
        enabled: false
        cost_power: 1
        cost_weight: 2.0
        threshold_to_consider: 0.5
    FleetMPPI:
      plugin: omnifleet_planner::OrderedMPPI
      time_steps: 56
      model_dt: 0.0666667
      batch_size: 1000
      vx_std: 0.2
      vy_std: 0.2
      wz_std: 0.4
      vx_max: 0.025
      vx_min: -0.025
      vy_max: 0.0
      wz_max: 0.08
      ax_max: 0.8
      ax_min: -0.8
      ay_max: 0.0
      ay_min: 0.0
      az_max: 1.5
      iteration_count: 1
      prune_distance: 1.7
      enforce_path_inversion: true
      transform_tolerance: 0.3
      temperature: 0.3
      gamma: 0.015
      motion_model: DiffDrive
      visualize: true
      TrajectoryVisualizer:
        trajectory_step: 1000
        time_step: 5
      reset_period: 1.0
      critics:
      - ConstraintCritic
      - CostCritic
      - GoalCritic
      - GoalAngleCritic
      - PathAlignCritic
      - PathFollowCritic
      - PathAngleCritic
      - PreferForwardCritic
      ConstraintCritic:
        enabled: true
        cost_power: 1
        cost_weight: 4.0
      CostCritic:
        enabled: true
        cost_power: 1
        cost_weight: 3.81
        critical_cost: 300.0
        consider_footprint: true
      GoalCritic:
        enabled: true
        cost_power: 1
        cost_weight: 10.0
        threshold_to_consider: 1.4
      GoalAngleCritic:
        enabled: true
        cost_power: 1
        cost_weight: 3.0
        threshold_to_consider: 0.5
      PathAlignCritic:
        enabled: true
        cost_power: 1
        cost_weight: 10.0
        threshold_to_consider: 0.5
        use_path_orientations: false
      PathFollowCritic:
        enabled: true
        cost_power: 1
        cost_weight: 10.0
        threshold_to_consider: 1.4
      PathAngleCritic:
        enabled: true
        cost_power: 1
        cost_weight: 10.0
        threshold_to_consider: 0.5
        forward_preference: true
      PreferForwardCritic:
        enabled: true
        cost_power: 1
        cost_weight: 10.0
        threshold_to_consider: 0.5
local_costmap:
  local_costmap:
    ros__parameters:
      use_sim_time: false
      update_frequency: 10.0
      publish_frequency: 5.0
      global_frame: map
      robot_base_frame: base_link
      transform_tolerance: 0.5
      rolling_window: true
      width: 4
      height: 4
      resolution: 0.01
      footprint: "[[0.25,0.185],[0.25,-0.185],[-0.25,-0.185],[-0.25,0.185]]"
      footprint_padding: 0.02
      plugins:
      - obstacle_layer
      - peer_layer
      - inflation_layer
      obstacle_layer:
        plugin: nav2_costmap_2d::ObstacleLayer
        origin_z: -1.0
        z_resolution: 0.2125
        z_voxels: 16
        mark_threshold: 0
        unknown_threshold: 15
        publish_voxel_map: false
        enabled: true
        footprint_clearing_enabled: true
        max_obstacle_height: 0.5
        observation_sources: lidar lidar_clearing
        lidar:
          topic: /rslidar_points
          sensor_frame: rslidar
          clearing: false
          marking: true
          data_type: PointCloud2
          raytrace_max_range: 8.0
          raytrace_min_range: 0.12
          obstacle_max_range: 6.0
          obstacle_min_range: 0.12
          min_obstacle_height: -0.03
          max_obstacle_height: 0.5
          observation_persistence: 0.0
        min_obstacle_height: -0.03
        lidar_clearing:
          topic: /rslidar_points
          sensor_frame: rslidar
          clearing: true
          marking: false
          data_type: PointCloud2
          raytrace_max_range: 8.0
          raytrace_min_range: 0.12
          obstacle_max_range: 6.0
          obstacle_min_range: 0.12
          min_obstacle_height: -0.03
          max_obstacle_height: 0.5
          observation_persistence: 0.0
      peer_layer:
        plugin: omnifleet_planner::PeerLayer
        enabled: true
        map_topic: /navigation/peer_map
        map_subscribe_transient_local: true
        subscribe_to_updates: false
      inflation_layer:
        plugin: nav2_costmap_2d::InflationLayer
        cost_scaling_factor: 2.0
        inflation_radius: 0.15
      always_send_full_costmap: true
