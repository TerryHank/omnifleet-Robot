#!/usr/bin/env python3
"""Publish the navigation height band for visualization only."""
import base64
import json
import numpy as np
import time
import rclpy
from rclpy.node import Node
from rclpy.qos import QoSProfile, ReliabilityPolicy
from sensor_msgs.msg import PointCloud2
from nav_msgs.msg import Odometry
from std_srvs.srv import Trigger
from rclpy.serialization import deserialize_message

INPUT = '/navigation/deskewed_points'
OUTPUT = '/navigation/height_filtered_points'
MIN_Z = -0.03
MAX_Z = 0.5
VOXEL_SIZE = 0.08
MAX_RATE_HZ = 2.0


def filter_cloud(message, min_z=MIN_Z, max_z=MAX_Z, center=None, downsample=True, project_z=None, density=1):
    fields = {field.name: field for field in message.fields}
    endian = '>' if message.is_bigendian else '<'
    formats = {7: 'f4', 8: 'f8'}
    dtype = np.dtype({
        'names': ['x', 'y', 'z'],
        'formats': [endian + formats[fields[k].datatype] for k in ('x', 'y', 'z')],
        'offsets': [fields[k].offset for k in ('x', 'y', 'z')],
        'itemsize': message.point_step,
    })
    points = np.ndarray((message.height, message.width), dtype=dtype,
                        buffer=message.data, strides=(message.row_step, message.point_step))
    valid = np.isfinite(points['x']) & np.isfinite(points['y']) & np.isfinite(points['z'])
    valid &= (points['z'] >= min_z) & (points['z'] <= max_z)
    if center is not None:
        valid &= (points['x'] - center[0]) ** 2 + (points['y'] - center[1]) ** 2 <= 9.
    records = np.ndarray((message.height, message.width, message.point_step), dtype=np.uint8,
                         buffer=message.data, strides=(message.row_step, message.point_step, 1))
    selected = records[valid]
    if len(selected) and downsample:
        xyz = np.column_stack([points[name][valid] for name in ('x', 'y', 'z')])
        _, indices = np.unique(np.floor(xyz / VOXEL_SIZE).astype(np.int64), axis=0, return_index=True)
        if density > 1:
            count = min(len(selected), density * len(indices))
            indices = np.linspace(0, len(selected) - 1, count, dtype=np.int64)
        selected = selected[indices]
    if project_z is not None:
        selected = selected[::10].copy()
    if project_z is not None and len(selected):
        # selected owns its data, so this changes only the display cloud.
        projected = np.ndarray((len(selected),), dtype=dtype, buffer=selected)
        projected['z'] = project_z
    result = PointCloud2()
    result.header = message.header
    result.fields = message.fields
    result.is_bigendian = message.is_bigendian
    result.point_step = message.point_step
    result.height = 1
    result.width = len(selected)
    result.row_step = result.width * result.point_step
    result.is_dense = True
    result.data = selected.tobytes()
    return result


class HeightFilteredCloud(Node):
    def __init__(self):
        super().__init__('navigation_height_cloud_visualizer')
        qos = QoSProfile(depth=1, reliability=ReliabilityPolicy.BEST_EFFORT)
        self.publisher = self.create_publisher(PointCloud2, OUTPUT, qos)
        self.subscription = self.create_subscription(PointCloud2, INPUT, self.on_cloud, qos)
        self.slam_publisher = self.create_publisher(
            PointCloud2, '/visualization/slam_points_below_1m', qos)
        self.slam_subscription = self.create_subscription(
            PointCloud2, '/lidar_odometry/localmap_points', self.on_slam_cloud, qos)
        self.local_publisher = self.create_publisher(
            PointCloud2, '/visualization/local_scan_points', qos)
        self.robot_center = None
        self.pose_subscription = self.create_subscription(
            Odometry, '/lidar_odometry/pose', self.on_pose, qos)
        self.last_publish = 0.
        self.last_slam_publish = 0.
        self.latest_slam_cloud = None
        self.snapshot_client = self.create_client(Trigger, "/visualization/slam_dense_snapshot")
        self.snapshot_retry_at = 0.
        self.slam_timer = self.create_timer(1.0, self.publish_slam_cloud)
        self.get_logger().info(f'{INPUT} -> {OUTPUT}: map Z in [{MIN_Z}, {MAX_Z}] m')

    def on_pose(self, message):
        if message.header.frame_id.lstrip('/') == 'map':
            position = message.pose.pose.position
            self.robot_center = (position.x, position.y, position.z)

    def on_cloud(self, message):
        if not (self.publisher.get_subscription_count() or self.local_publisher.get_subscription_count()):
            return
        now = time.monotonic()
        if now-self.last_publish < 1./MAX_RATE_HZ:
            return
        if message.header.frame_id.lstrip('/') != 'map':
            self.get_logger().warning(
                'Expected map-frame cloud; refusing to apply map-height limits in another frame',
                throttle_duration_sec=5.0)
            return
        if self.publisher.get_subscription_count():
            self.publisher.publish(filter_cloud(message))
        if self.robot_center is not None and self.local_publisher.get_subscription_count():
            self.local_publisher.publish(filter_cloud(
                message, min_z=-np.inf, max_z=np.inf, center=self.robot_center, downsample=False, project_z=self.robot_center[2] + .1))
        self.last_publish = now

    def on_slam_cloud(self, message):
        if message.header.frame_id.lstrip('/') != 'map':
            return
        now = time.monotonic()
        if now - self.last_slam_publish < 1. / MAX_RATE_HZ:
            return
        self.latest_slam_cloud = filter_cloud(message, min_z=-np.inf, max_z=2., density=5)
        self.last_slam_publish = now


    def publish_slam_cloud(self):
        if not self.slam_publisher.get_subscription_count():
            return
        if self.latest_slam_cloud is not None:
            self.latest_slam_cloud.header.stamp = self.get_clock().now().to_msg()
            self.slam_publisher.publish(self.latest_slam_cloud)
        elif time.monotonic() >= self.snapshot_retry_at and self.snapshot_client.service_is_ready():
            self.snapshot_retry_at = time.monotonic() + 60.
            self.snapshot_client.call_async(Trigger.Request()).add_done_callback(self.on_snapshot)

    def on_snapshot(self, future):
        if self.latest_slam_cloud is not None:
            return
        try:
            reply = future.result()
            if not reply.success:
                self.get_logger().warning(reply.message)
                return
            encoded = json.loads(reply.message)['cloud_cdr_base64']
            cloud = deserialize_message(base64.b64decode(encoded), PointCloud2)
            self.latest_slam_cloud = filter_cloud(cloud, min_z=-np.inf, max_z=2., downsample=False)
        except Exception as exc:
            self.get_logger().warning(f'MOLA snapshot unavailable: {exc}')


def main():
    rclpy.init()
    node = HeightFilteredCloud()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
