[Unit]
Description=OmniFleet RMF native traffic blockade (central domain)
PartOf=omnifleet-rmf.target
Wants=omnifleet-wsl-zenoh-router.service
After=omnifleet-wsl-zenoh-router.service

[Service]
Type=simple
WorkingDirectory=/home/zhangwnag/workspaces/omnifleet_ws
ExecStart=/bin/bash /home/zhangwnag/workspaces/omnifleet_ws/src/system/omnifleet_rmf_adapter/scripts/run.bash blockade
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=omnifleet-rmf.target
