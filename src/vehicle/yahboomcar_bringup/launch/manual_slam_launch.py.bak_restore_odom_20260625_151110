import os

from ament_index_python.packages import get_package_share_directory
from launch import LaunchDescription
from launch.actions import DeclareLaunchArgument, IncludeLaunchDescription
from launch.conditions import IfCondition
from launch.launch_description_sources import PythonLaunchDescriptionSource
from launch.substitutions import Command, LaunchConfiguration, PathJoinSubstitution
from launch_ros.actions import Node
from launch_ros.parameter_descriptions import ParameterValue
from launch_ros.substitutions import FindPackageShare


def generate_launch_description():
    bringup_share = get_package_share_directory('yahboomcar_bringup')
    slam_share = get_package_share_directory('slam_toolbox')

    model = LaunchConfiguration('model')
    use_sim_time = LaunchConfiguration('use_sim_time')
    enable_slam = LaunchConfiguration('enable_slam')
    enable_driver = LaunchConfiguration('enable_driver')
    enable_ekf = LaunchConfiguration('enable_ekf')
    enable_lidar = LaunchConfiguration('enable_lidar')
    pub_odom_tf = LaunchConfiguration('pub_odom_tf')
    linear_deadband = LaunchConfiguration('linear_deadband')
    steering_deadband = LaunchConfiguration('steering_deadband')
    steering_offset = LaunchConfiguration('steering_offset')
    use_feedback_angular = LaunchConfiguration('use_feedback_angular')
    angular_deadband = LaunchConfiguration('angular_deadband')
    angular_scale_z = LaunchConfiguration('angular_scale_z')
    dt_max = LaunchConfiguration('dt_max')
    lidar_udp_ip = LaunchConfiguration('lidar_udp_ip')
    lidar_udp_port = LaunchConfiguration('lidar_udp_port')
    lidar_scan_mode = LaunchConfiguration('lidar_scan_mode')
    slam_params_file = LaunchConfiguration('slam_params_file')
    ekf_params_file = LaunchConfiguration('ekf_params_file')

    robot_description = ParameterValue(Command(['xacro ', model]), value_type=str)

    robot_state_publisher = Node(
        package='robot_state_publisher',
        executable='robot_state_publisher',
        output='screen',
        parameters=[{'robot_description': robot_description, 'use_sim_time': use_sim_time}],
    )

    driver_node = Node(
        condition=IfCondition(enable_driver),
        package='yahboomcar_bringup',
        executable='Ackman_driver_R2',
        name='driver_node',
        output='screen',
        parameters=[{
            'xlinear_limit': 0.45,
            'angular_limit': 0.80,
            'nav_use_rotvel': False,
            'cmd_angular_to_steering': True,
            'wheelbase': 0.362295943,
            'steering_limit': 30.0,
        }],
    )

    base_node = Node(
        condition=IfCondition(enable_driver),
        package='yahboomcar_base_node',
        executable='base_node_R2',
        output='screen',
        parameters=[{
            'pub_odom_tf': pub_odom_tf,
            'wheelbase': 0.362295943,
            'linear_deadband': ParameterValue(linear_deadband, value_type=float),
            'steering_deadband': ParameterValue(steering_deadband, value_type=float),
            'steering_offset': ParameterValue(steering_offset, value_type=float),
            'use_feedback_angular': ParameterValue(use_feedback_angular, value_type=bool),
            'angular_deadband': ParameterValue(angular_deadband, value_type=float),
            'angular_scale_z': ParameterValue(angular_scale_z, value_type=float),
            'dt_max': ParameterValue(dt_max, value_type=float),
        }],
    )

    imu_filter_node = Node(
        condition=IfCondition(enable_driver),
        package='imu_filter_madgwick',
        executable='imu_filter_madgwick_node',
        output='screen',
        parameters=[os.path.join(bringup_share, 'param', 'imu_filter_param.yaml')],
    )

    ekf_node = Node(
        condition=IfCondition(enable_ekf),
        package='robot_localization',
        executable='ekf_node',
        name='ekf_filter_node',
        output='screen',
        parameters=[ekf_params_file],
        remappings=[('/odometry/filtered', '/odom')],
    )


    lidar_node = Node(
        condition=IfCondition(enable_lidar),
        package='rplidar_ros',
        executable='rplidar_node',
        name='rplidar_node',
        output='screen',
        parameters=[{
            'channel_type': 'udp',
            'udp_ip': lidar_udp_ip,
            'udp_port': lidar_udp_port,
            'frame_id': 'laser_frame',
            'inverted': False,
            'angle_compensate': True,
            'scan_mode': lidar_scan_mode,
        }],
    )

    slam_launch = IncludeLaunchDescription(
        PythonLaunchDescriptionSource(os.path.join(slam_share, 'launch', 'online_async_launch.py')),
        condition=IfCondition(enable_slam),
        launch_arguments={
            'use_sim_time': use_sim_time,
            'slam_params_file': slam_params_file,
        }.items(),
    )

    return LaunchDescription([
        DeclareLaunchArgument(
            'model',
            default_value=PathJoinSubstitution([
                FindPackageShare('lunshi_chassis_description'),
                'urdf',
                'lunshi_ackermann.urdf.xacro',
            ]),
        ),
        DeclareLaunchArgument('use_sim_time', default_value='false'),
        DeclareLaunchArgument('enable_driver', default_value='true'),
        DeclareLaunchArgument('enable_ekf', default_value='true'),
        DeclareLaunchArgument('enable_slam', default_value='true'),
        DeclareLaunchArgument('enable_lidar', default_value='true'),
        DeclareLaunchArgument('pub_odom_tf', default_value='false'),
        DeclareLaunchArgument('linear_deadband', default_value='0.0'),
        DeclareLaunchArgument('steering_deadband', default_value='1.0'),
        DeclareLaunchArgument('steering_offset', default_value='0.0'),
        DeclareLaunchArgument('use_feedback_angular', default_value='false'),
        DeclareLaunchArgument('angular_deadband', default_value='0.0'),
        DeclareLaunchArgument('angular_scale_z', default_value='1.0'),
        DeclareLaunchArgument('dt_max', default_value='0.5'),
        DeclareLaunchArgument('lidar_udp_ip', default_value='192.168.11.2'),
        DeclareLaunchArgument('lidar_udp_port', default_value='8089'),
        DeclareLaunchArgument('lidar_scan_mode', default_value='Standard'),
        DeclareLaunchArgument(
            'slam_params_file',
            default_value=os.path.join(bringup_share, 'param', 'manual_slam_toolbox.yaml'),
        ),
        DeclareLaunchArgument(
            'ekf_params_file',
            default_value=os.path.join(bringup_share, 'param', 'ekf_manual_slam.yaml'),
        ),
        robot_state_publisher,
        driver_node,
        base_node,
        imu_filter_node,
        ekf_node,
        lidar_node,
        slam_launch,
    ])
