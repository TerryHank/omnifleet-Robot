<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lunshi_chassis">

  <!-- Generated Xacro source. Final URDF is produced by xacro before robot_state_publisher / RViz / Gazebo. -->
  <xacro:arg name="use_gazebo" default="false"/>

