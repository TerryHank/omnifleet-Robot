  <xacro:property name="s3_samples" value="3200"/>
  <xacro:property name="s3_min_angle" value="-3.141592653589793"/>
  <xacro:property name="s3_max_angle" value="3.141592653589793"/>
  <xacro:property name="s3_min_range" value="0.05"/>
  <xacro:property name="s3_max_range" value="40.0"/>
  <xacro:property name="s3_range_resolution" value="0.01"/>
  <xacro:property name="s3_noise_stddev" value="0.025"/>

