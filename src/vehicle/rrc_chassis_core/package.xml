<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rrc_chassis_core</name>
  <version>0.1.0</version>
  <description>Always-on hardware core for the Yahboom R2 STM32 Ackermann chassis.</description>
  <maintainer email="iecme@example.com">iecme</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>lunshi_chassis_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>yahboomcar_base_node</exec_depend>
  <exec_depend>yahboomcar_bringup</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
