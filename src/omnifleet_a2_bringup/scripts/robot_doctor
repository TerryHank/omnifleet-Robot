#!/usr/bin/env python3
"""远端阿克曼 Airy + GLIM + Nav2 生产链只读体检工具。"""

import argparse
import os
from pathlib import Path
import subprocess
import sys


LEVELS = {"PASS": 0, "WARN": 1, "FAIL": 2}
LOCAL_PLUGIN = {
    "obstacle": "obstacle_layer",
    "voxel": "voxel_layer",
    "stvl": "stvl_layer",
}


class Doctor:
    def __init__(self, timeout):
        self.timeout = timeout
        self.results = []

    def run(self, command, timeout=None):
        try:
            result = subprocess.run(
                command,
                capture_output=True,
                text=True,
                timeout=timeout or self.timeout,
                check=False,
            )
            output = "\n".join(
                part.strip() for part in (result.stdout, result.stderr) if part.strip()
            )
            return result.returncode, output
        except subprocess.TimeoutExpired as error:
            stdout = error.stdout.decode() if isinstance(error.stdout, bytes) else error.stdout
            stderr = error.stderr.decode() if isinstance(error.stderr, bytes) else error.stderr
            output = "\n".join(part.strip() for part in (stdout, stderr) if part)
            return 124, output
        except FileNotFoundError as error:
            return 127, str(error)

    def record(self, status, name, evidence, fault_unit):
        self.results.append((status, name, evidence, fault_unit))

    def command_contains(self, name, command, expected, fault_unit, timeout=None):
        code, output = self.run(command, timeout=timeout)
        found = code == 0 and all(token in output for token in expected)
        status = "PASS" if found else "FAIL"
        compact = " | ".join(line.strip() for line in output.splitlines() if line.strip())
        if len(compact) > 220:
            compact = compact[:217] + "..."
        self.record(
            status,
            name,
            compact or f"命令退出码={code}，无输出",
            fault_unit,
        )
        return found

    def service(self, unit):
        self.command_contains(
            f"systemd {unit}",
            ["systemctl", "is-active", unit],
            ["active"],
            f"{unit}或其硬件接口",
        )

    def topic_sample(self, topic, field, fault_unit, durability=None):
        command = [
            "ros2", "topic", "echo", topic, "--field", field, "--once",
        ]
        if durability:
            command.extend(["--qos-durability", durability])
        code, output = self.run(command)
        has_sample = code == 0 and bool(output.strip())
        compact = " | ".join(line.strip() for line in output.splitlines() if line.strip())
        if len(compact) > 160:
            compact = compact[:157] + "..."
        self.record(
            "PASS" if has_sample else "FAIL",
            f"实时消息 {topic}",
            compact or f"{self.timeout:.1f}s内未收到消息",
            fault_unit,
        )
        return has_sample

    def topic_graph(self, topic, expected_nodes, fault_unit):
        return self.command_contains(
            f"话题拓扑 {topic}",
            ["ros2", "topic", "info", topic, "-v"],
            expected_nodes,
            fault_unit,
        )

    def lifecycle(self, node):
        self.command_contains(
            f"Lifecycle {node}",
            ["ros2", "lifecycle", "get", node],
            ["active"],
            f"{node}或GLIM生命周期管理器",
        )

    def parameter(self, nodes, parameter, expected, name, fault_unit):
        outputs = []
        for node in nodes:
            code, output = self.run(["ros2", "param", "get", node, parameter])
            outputs.append(f"{node}: {output}")
            if code == 0 and all(token in output for token in expected):
                self.record("PASS", name, outputs[-1], fault_unit)
                return True
        self.record("FAIL", name, " | ".join(outputs), fault_unit)
        return False

    def tf(self, source, target, fault_unit):
        code, output = self.run(
            ["timeout", "4", "ros2", "run", "tf2_ros", "tf2_echo", source, target],
            timeout=6,
        )
        found = "Translation:" in output and "Rotation:" in output
        evidence = "TF可查询" if found else (output.strip() or f"退出码={code}")
        self.record("PASS" if found else "FAIL", f"TF {source} -> {target}", evidence, fault_unit)

    def base(self):
        self.service("omnifleet-a2-chassis.service")
        self.service("omnifleet-a2-airy.service")

        serial = Path("/dev/myserial")
        if serial.exists():
            self.record("PASS", "STM32串口绑定", str(serial.resolve()), "无")
        else:
            self.record("FAIL", "STM32串口绑定", "/dev/myserial不存在", "udev规则、USB线或STM32枚举")

        self.topic_sample("/rslidar_points", "width", "Airy点云驱动或网络")
        self.topic_sample("/rslidar_imu_data", "linear_acceleration", "Airy内置IMU或RoboSense驱动")
        self.topic_sample("/omnifleet_a2/chassis/velocity_raw", "linear.x", "STM32串口接收、固件或底盘驱动")
        self.topic_graph(
            "/cmd_vel",
            ["Node name: omnifleet_a2_driver"],
            "单点导航速度到底盘驱动的连接",
        )

    def slam(self):
        self.topic_sample("/odom", "pose.pose.position", "GLIM里程计或odom语义适配")
        self.topic_sample(
            "/glim_ros/points_corrected", "width", "GLIM点云预处理/里程计前端"
        )
        self.topic_graph(
            "/glim_ros/map",
            ["Node name: glim_ros", "Node name: omnifleet_a2_glim_map_projector"],
            "GLIM全局地图发布器到二维投影器的连接",
        )
        self.topic_sample("/map", "info.width", "GLIM地图投影或地图会话")
        self.tf("map", "odom", "GLIM全局建图或TF发布配置")
        self.tf("odom", "base_link", "GLIM连续LIO或base_frame配置")

    def nav(self, terrain_mode, local_mode):
        self.topic_sample("/rslidar_points", "width", "Airy原始点云/Nav2官方障碍层输入")
        self.lifecycle("/planner_server")
        self.lifecycle("/controller_server")
        self.lifecycle("/bt_navigator")
        self.command_contains(
            "NavigateToPose动作服务",
            ["ros2", "action", "info", "/navigate_to_pose"],
            ["Action servers: 1"],
            "BT Navigator或Nav2生命周期",
        )

        expected_local = LOCAL_PLUGIN[local_mode]
        self.parameter(
            ["/local_costmap/local_costmap", "/local_costmap"],
            "plugins",
            [expected_local, "inflation_layer"],
            f"Local Costmap模式={local_mode}",
            "local_obstacle_mode参数覆盖或对应插件依赖",
        )

        if terrain_mode == "2_5d":
            global_expected = ["static_layer", "traversability_layer", "inflation_layer"]
            self.topic_sample("/omnifleet_a2/terrain/grid_map", "layers", "Elevation/2.5D地形映射")
            self.topic_sample(
                "/omnifleet_a2/terrain/costmap",
                "info.width",
                "GridMap到Nav2地形代价适配",
                durability="transient_local",
            )
        else:
            global_expected = ["static_layer", "obstacle_layer", "inflation_layer"]
        self.parameter(
            ["/global_costmap/global_costmap", "/global_costmap"],
            "plugins",
            global_expected,
            f"Global Costmap模式={terrain_mode}",
            "terrain_mode参数覆盖或Static/Traversability插件",
        )

        chains = [
            ("/cmd_vel", ["controller_server", "omnifleet_a2_driver"], "Nav2到底盘直连"),
        ]
        for topic, nodes, fault in chains:
            self.topic_graph(topic, nodes, fault)

    def report(self):
        print("\n远端机器人只读体检结果")
        print("=" * 72)
        first_fail = None
        worst = 0
        for status, name, evidence, fault_unit in self.results:
            worst = max(worst, LEVELS[status])
            print(f"[{status:4}] {name}")
            print(f"       证据: {evidence}")
            if status != "PASS":
                print(f"       最小故障单元: {fault_unit}")
            if status == "FAIL" and first_fail is None:
                first_fail = (name, fault_unit)
        print("-" * 72)
        if first_fail:
            print(f"结论: 首个失败项是“{first_fail[0]}”，先隔离“{first_fail[1]}”。")
            print("不要同时修改上游算法、Costmap和底盘参数。")
        else:
            print("结论: 所选范围全部通过；若仍有异常，执行同目标单变量替换与回装验证。")
        return 1 if worst >= LEVELS["FAIL"] else 0


def parse_args(argv):
    parser = argparse.ArgumentParser(
        description="远端阿克曼 Airy + GLIM + Nav2 生产链只读体检"
    )
    parser.add_argument(
        "--scope", choices=("base", "slam", "nav"), default="base",
        help="检查范围：base仅硬件底座，slam追加GLIM/地图，nav追加Nav2全链；默认base",
    )
    parser.add_argument(
        "--terrain-mode", choices=("2d", "2_5d"), default="2d",
        help="nav范围期望的全局地图模式；默认2d",
    )
    parser.add_argument(
        "--local-obstacle-mode", choices=("obstacle", "voxel", "stvl"),
        default="obstacle", help="nav范围期望的局部障碍层；默认obstacle",
    )
    parser.add_argument(
        "--timeout", type=float, default=15.0,
        help="单项实时消息等待秒数；默认15秒，覆盖GLIM全局地图的低频发布周期",
    )
    return parser.parse_args(argv)


def main(argv=None):
    args = parse_args(argv or sys.argv[1:])
    if not os.environ.get("ROS_DISTRO"):
        print("错误：尚未source ROS 2环境。", file=sys.stderr)
        return 2

    doctor = Doctor(args.timeout)
    doctor.base()
    if args.scope in ("slam", "nav"):
        doctor.slam()
    if args.scope == "nav":
        doctor.nav(args.terrain_mode, args.local_obstacle_mode)
    return doctor.report()


if __name__ == "__main__":
    raise SystemExit(main())
