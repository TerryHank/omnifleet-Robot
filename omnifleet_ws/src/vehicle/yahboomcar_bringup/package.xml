<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>yahboomcar_bringup</name>
  <version>0.1.0</version>
  <description>ROS 2 driver and bringup utilities for the Yahboom R2 STM32 Ackermann chassis.</description>
  <maintainer email="TerryHank@users.noreply.github.com">TerryHank</maintainer>
  <license>Proprietary</license>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>lifecycle_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
