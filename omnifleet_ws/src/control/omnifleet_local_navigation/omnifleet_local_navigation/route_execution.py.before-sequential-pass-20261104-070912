def yaw(pose):
    q = pose.orientation
    return math.atan2(2*(q.w*q.z+q.x*q.y), 1-2*(q.y*q.y+q.z*q.z))


def oriented_route(points, start_yaw=None):
    result = copy.deepcopy(points)
    reference = start_yaw if start_yaw is not None else (yaw(result[0].pose) if result else 0.)
    for i, point in enumerate(result):
        if point.kind == "stop" or i == len(result)-1:
            reference = yaw(point.pose)
            continue
        following = next((p for p in result[i+1:] if math.hypot(p.pose.position.x-point.pose.position.x, p.pose.position.y-point.pose.position.y) > 1e-4), None)
        if following:
            direction = math.atan2(following.pose.position.y-point.pose.position.y, following.pose.position.x-point.pose.position.x)
            angle = min((direction, direction+math.pi), key=lambda a: abs(math.atan2(math.sin(a-reference), math.cos(a-reference))))
            point.pose.orientation.x = point.pose.orientation.y = 0.
            point.pose.orientation.z, point.pose.orientation.w = math.sin(angle/2), math.cos(angle/2)
            reference = angle
    return result


def split_blocks(points):
    blocks, start = [], 0
    for i, point in enumerate(points):
        if point.kind == "stop" or i == len(points)-1:
            blocks.append((start, i+1))
            start = i+1
    return blocks


def topic(node, suffix):
    prefix = node.frame_id.rpartition('/')[0]
    return ('/'+prefix if prefix else '')+'/'+suffix.lstrip('/')


def path_valid(grid, path, allow_unknown=False):
    if grid.info.resolution <= 0 or not path.poses or len(grid.data) != grid.info.width*grid.info.height:
        return False
    angle = yaw(grid.info.origin)
    cs, sn = math.cos(angle), math.sin(angle)
    def free(x,y):
        dx,dy=x-grid.info.origin.position.x,y-grid.info.origin.position.y
        ix,iy=math.floor((cs*dx+sn*dy)/grid.info.resolution),math.floor((-sn*dx+cs*dy)/grid.info.resolution)
        if not (0<=ix<grid.info.width and 0<=iy<grid.info.height):
            return False
        value=grid.data[iy*grid.info.width+ix]
        return 0<=value<99 or (value==-1 and allow_unknown)
    previous = path.poses[0].pose.position
    for pose in path.poses:
        p=pose.pose.position
        steps=max(1,math.ceil(math.hypot(p.x-previous.x,p.y-previous.y)/(grid.info.resolution*.5)))
        if any(not free(previous.x+(p.x-previous.x)*k/steps,previous.y+(p.y-previous.y)*k/steps) for k in range(steps+1)):
            return False
        previous=p
    return True


class OutputGate:
    def __init__(self,node):self.node=node
    def publish(self,_message):self.node.inhibit_output()

class ContinuousRoute:
    def __init__(self, node):
        self.n = node
        self.navigator = ActionClient(node, NavigateThroughPoses, topic(node, "navigation_backend/navigate_through_poses"))
        self.single = ActionClient(node, NavigateToPose, topic(node, "navigation_backend/navigate_to_pose"))
        self.waypoints=ActionClient(node,FollowWaypoints,topic(node,"navigation_backend/follow_waypoints"))
        self.single_point = False
        self.strategy = 'sequential'
        self.sequential = True
        self.native_behavior_tree = ""
        self.planner = ActionClient(node, ComputePathThroughPoses, topic(node, "compute_path_through_poses"))
        self.parameters = node.create_client(GetParameters, topic(node, 'planner_server/get_parameters'))
        self.configuration_pending = False
        self.allow_unknown = False
        self.active = False
        self.phase = "idle"
        self.epoch = 0
        self.requests = {}
        self.points = []
        self.states = []
        self.block = 0
        self.controller = "FollowPath"
        self.health = LocalizationHealth()
        # Read-only safety telemetry: counters are updated in the existing 20 Hz
        # check without I/O; publication is throttled by the node timer.
        self.tf_check_count = 0
        self.tf_over500_count = 0
        self.tf_max_age_ms = None
        self.tf_max_check_interval_ms = 0.0
        self.tf_last_check_mono = None
        self.tf_stale_drop_count = 0
        self.tf_last_dropped_stamp = None
        self.pose = self.odom = None
        self.grid = None
        self.executed_path = None
        self.run_id = ""
        self.bt_file = None
        self.cancel_reason = ""
        self.finished_at = None
        self.preflight_only = False
        latched = QoSProfile(depth=1, reliability=ReliabilityPolicy.RELIABLE, durability=DurabilityPolicy.TRANSIENT_LOCAL)
        for client, endpoint in ((self.navigator,'navigation_backend/navigate_through_poses'),
                                 (self.single,'navigation_backend/navigate_to_pose'),
                                 (self.waypoints,'navigation_backend/follow_waypoints'),
                                 (self.planner,'compute_path_through_poses')):
            node.create_subscription(GoalStatusArray,topic(node,endpoint+'/_action/status'),
                lambda message,c=client:self.observe_action_status(c,message),latched)
        node.create_subscription(String, topic(node, "controller_selector"), lambda m: setattr(self, 'controller', m.data), latched)
        node.create_subscription(OccupancyGrid, topic(node, "global_costmap/costmap"), lambda m: setattr(self, 'grid', (time.monotonic(),m)), latched)
        node.create_subscription(Odometry, topic(node, "lidar_odometry/pose"), self.on_pose, qos_profile_sensor_data)
        node.create_subscription(Odometry, topic(node, "odom"), lambda m: setattr(self, 'odom', (time.monotonic(), m)), qos_profile_sensor_data)
        node.create_subscription(String, topic(node, "omnifleet_t2/waypoints/execution_state"), self.on_execution_state, 10)
        node.create_subscription(TFMessage, topic(node, "tf"), self.on_tf, qos_profile_sensor_data)
        self.zero = OutputGate(node)
        self.follow = TrailFollow(self)
        node.create_timer(.05, self.tick)
        node.create_timer(1.0, self.publish_health_telemetry)

    def on_pose(self, message):
        h=message.header.stamp
        stamp=h.sec+h.nanosec*1e-9
        if self.health.trace:
            self.health.trace.emit("pose_received", stamp=stamp)
        if not stamp_is_fresh(stamp, time.time()):
            # 中文说明：收到的 pose 已超过500ms，只记录并丢弃，
            # 不得覆盖当前有效 pose，也不得更新定位健康状态。
            self.tf_stale_drop_count += 1
            if self.health.trace:
                self.health.trace.emit("pose_stale_dropped", stamp=stamp)
            self.tf_last_dropped_stamp = stamp
            return
        self.tf_last_dropped_stamp = None
        received_mono = time.monotonic()
        self.pose = (received_mono, message)
        # MOLA pose is the same map->base_link observation that is published
        # on /tf. Refresh the health state immediately; the TF listener keeps
        # receiving the dynamic transform independently.
        self.health.observe(stamp, received_mono)
        self.on_tf(None)

    def on_tf(self, message):
        # Compose the real chain for direct MOLA and REP105 alike. A fresh
        # odom edge cannot hide an old MOLA observation.
        self.health.trace_active=self.active
        self.health.trace_phase=self.phase
        prefix = self.n.frame_id.rpartition('/')[0]
        base = (prefix+'/' if prefix else '')+'base_link'
        try:
            transform = self.n.tf.lookup_transform(self.n.frame_id, base, Time())
            stamp = transform.header.stamp.sec+transform.header.stamp.nanosec*1e-9
            tf_stamp=stamp
            pose_stamp=None
            if self.pose:
                h=self.pose[1].header.stamp
                pose_stamp=h.sec+h.nanosec*1e-9
                stamp=min(stamp,h.sec+h.nanosec*1e-9)
            wall=time.time()
            self.health.query=dict(ok=True, tf_stamp=tf_stamp, pose_stamp=pose_stamp,
                                   available_query_mono=time.monotonic(), target=self.n.frame_id, source=base)
            if self.health.trace:self.health.trace.emit("query", **self.health.query)
            if not stamp_is_fresh(stamp, wall):
                # 中文说明：查询到的 TF 已超过500ms，只记录并丢弃，
                # 不得写入 health，也不得用旧 TF 刷新定位状态。
                self.tf_stale_drop_count += 1
                self.health.query.update(stale_observed=True, age_ms=(wall-stamp)*1000)
                if self.health.trace:self.health.trace.emit("tf_stale_dropped", **self.health.query)
                self.tf_last_dropped_stamp = stamp
                return
            if stamp != self.health.stamp:self.health.observe(stamp,time.monotonic())
        except Exception as exc:
            self.health.query=dict(ok=False, error=type(exc).__name__, query_mono=time.monotonic())
            if self.health.trace:self.health.trace.emit("query", **self.health.query)
            pass

    def publish_health_telemetry(self):
        # Status publication is outside the safety check and does not alter its
        # query, timestamp, or decision semantics.
        self.n.publish_catalog()

    def catalog(self):
        return {'tf_age_ms': self.health.age_ms, 'localization_status': self.health.reason,
                'follow_stream':self.follow.catalog() if getattr(self,'strategy','')=='trail_follow' else {},
                'formation_stream':self.formation.catalog() if getattr(self,'strategy','')=='formation_follow' else {},
                'tf_check_count': self.tf_check_count,
                'tf_over500_count': self.tf_over500_count,
                'tf_stale_drop_count': self.tf_stale_drop_count,
                'tf_max_age_ms': self.tf_max_age_ms,
                'tf_max_check_interval_ms': self.tf_max_check_interval_ms,
                'execution_strategy': getattr(self, 'strategy', 'sequential'),
                'run_id': self.run_id, 'phase': self.phase, 'block': self.block+1 if self.active else 0,
                'blocks': len(getattr(self, 'blocks', [])), 'waypoint_states': self.states,
                'remaining_wait': max(0., getattr(self, 'wait_until', 0.)-time.monotonic()) if self.phase == 'waiting' else 0.,
                'planner_id': getattr(self, 'planner_id', ''), 'controller_id': getattr(self, 'controller_id', '')}

    def inputs_ready(self):
        # TF/pose age is diagnostic only; it no longer blocks task admission.
        # A pose sample and a current costmap are still required.
        return not self.input_reason()

    def input_reason(self):
        if self.pose is None:return '尚未收到有效MOLA位姿'
        if self.grid is None:return '尚未收到全局代价地图'
        age=time.monotonic()-self.grid[0]
        if age>=3:return f'全局代价地图超过3秒未更新（{age:.2f}秒）'
        return ''

    def set_phase(self, phase, text):
        self.phase = phase
        self.n.publish_status(text)
        self.n.publish_catalog()

    def start(self, points, preflight_only=False, single_point=False, execution_backend=""):
        if self.n.navigation_active or self.requests:
            self.n.publish_status("已有任务或取消请求尚未结束，不能重复开始")
            return
        self.single_point = single_point
        try:
            self.strategy = 'formation_follow' if execution_backend=='formation_follow' else 'trail_follow' if execution_backend=='trail_follow' else 'nav2_waypoints' if execution_backend=='nav2_waypoints' else 'single' if single_point else navigation_strategy()
        except (OSError, ValueError, KeyError) as error:
            self.n.publish_status(f'不能开始：读取导航策略失败：{error}')
            return
        self.sequential = self.strategy == 'sequential'
        if not points or not (self.waypoints if self.strategy=='nav2_waypoints' else self.single if single_point or self.sequential or self.strategy in ('trail_follow','formation_follow') else self.navigator).server_is_ready() or not self.planner.server_is_ready():
            self.n.publish_status("不能开始：请添加航点并等待多点导航和规划服务就绪")
            return
        if not self.inputs_ready():
            self.n.publish_status("不能开始："+self.input_reason())
            return
        self.epoch += 1
        self.run_id = uuid.uuid4().hex
        self.backend_initializing=False;self.initialization_announced=False
        self.active = self.n.navigation_active = True
        self.failed = False
        self.configuration_pending = False
        self.preflight_only = preflight_only
        self.points = copy.deepcopy(points) if self.sequential else oriented_route(points, yaw(self.pose[1].pose.pose))
        self.blocks = [(0,len(points))] if self.strategy=='nav2_waypoints' else [(i, i+1) for i in range(len(points))] if self.sequential else split_blocks(self.points)
        self.states = ['待通过']*len(points)
        self.block = self.preflight_index = 0
        self.planner_id, self.controller_id = self.n.preview_planner_id, self.controller
        self.radius = self.n.pass_radius
        self.n.preview_revision += 1
        self.n.preview_dirty = False
        if self.n.preview_goal_handle:
            self.n.preview_goal_handle.cancel_goal_async()
        self.preview = NavPath()
        self.preview.header.frame_id = self.n.frame_id
        self.initial_pose = copy.deepcopy(self.pose[1].pose.pose)
        if self.strategy=='formation_follow':
            if not hasattr(self,'formation'):self.formation=FormationFollow(self)
            self.formation.start(self.points)
            self.set_phase('tracking','编队动态目标：本车Nav2持续规划与避障；丢失目标即停止')
            return
        if self.strategy=='trail_follow':
            self.follow.start(self.points)
            self.set_phase('tracking','实时车距跟随：本车规划避障，按前车定位速度跟随；最高速度读取永久参数')
            return
        # Temporarily bypass whole-route preflight for native continuous navigation.
        # if self.sequential and not preflight_only:
        if (self.sequential or self.strategy == 'through_poses') and not preflight_only:
            self.send_block()
            return
        self.set_phase('preplanning', '开始前检查整条路线；规划通过之前不会行驶')
        self.configuration_pending = True
        self.configuration_deadline = time.monotonic()+8
        epoch = self.epoch
        future = self.parameters.call_async(GetParameters.Request(names=[self.planner_id+'.allow_unknown']))
        def configured(f):
            if epoch != self.epoch or not self.active:
                return
            self.configuration_pending = False
            try:
                values = f.result().values
                if len(values)!=1 or values[0].type!=1:
                    raise RuntimeError('不能读取当前规划器的未知区域策略')
                self.allow_unknown = values[0].bool_value
                self.plan_next_block()
            except Exception as error:
                self.stop(f'读取规划配置失败：{error}', failed=True)
        future.add_done_callback(configured)

    def stamped(self, pose):
        value = PoseStamped()
        value.header.frame_id = self.n.frame_id
        value.header.stamp = self.n.get_clock().now().to_msg()
        value.pose = copy.deepcopy(pose)
        return value

    def submit(self, client, goal, result_fn, role, feedback=None):
        key = uuid.uuid4().hex
        entry = {'epoch': self.epoch, 'role': role, 'handle': None, 'deadline': time.monotonic()+10,
                 'cancel': False, 'cancel_sent': False, 'result': result_fn, 'client': client}
        self.requests[key] = entry
        try:
            f = client.send_goal_async(goal, feedback_callback=(lambda msg: feedback(msg) if feedback and key in self.requests and not self.requests[key]['cancel'] and self.requests[key]['epoch']==self.epoch else None))
            f.add_done_callback(lambda future: self.accepted(key, future))
        except Exception as error:
            self.requests.pop(key, None)
            self.request_failed(role,f"请求发送失败：{error}")
        return key

    def accepted(self, key, future):
        entry = self.requests.get(key)
        if not entry:
            return
        try:
            handle = future.result()
            if not handle.accepted:
                raise RuntimeError('action请求被拒绝')
            entry['handle'] = handle
            if entry['role']=='navigation' and entry['epoch']==self.epoch and not entry['cancel'] and not getattr(self,'backend_initializing',False):
                self.n.inhibited = False
                self.n.arm_navigation_output()
            entry['deadline'] = time.monotonic()+15 if entry['role'] == 'plan' else float('inf')
            handle.get_result_async().add_done_callback(lambda f: self.result(key, f))
            if entry['cancel'] or entry['epoch'] != self.epoch:
                self.cancel(entry)
        except Exception as error:
            self.requests.pop(key, None)
            if entry['epoch'] == self.epoch and not entry['cancel']:
                self.request_failed(entry['role'],f"提交失败：{error}")

    def result(self, key, future):
        entry = self.requests.pop(key, None)
        if not entry or entry['cancel'] or entry.get('superseded') or entry['epoch'] != self.epoch:
            return
        try:
            wrapped = future.result()
            if wrapped.status != 4:
                raise RuntimeError(f"action状态={wrapped.status}")
            entry['result'](wrapped.result)
        except Exception as error:
            self.request_failed(entry['role'],f"{entry['role']}失败：{error}")

    def request_failed(self, role, reason):
        if (role=='navigation' or (role=='plan' and getattr(self,'phase',None)=='preplanning' and not self.preflight_only)) and self.n.recover_from_nav2_failure():return
        self.stop(reason,failed=True)

    def _retire_cancelled(self, entry):
        for key, value in list(self.requests.items()):
            if value is entry:
                self.requests.pop(key, None)

    def observe_action_status(self, client, message):
        terminal = {bytes(status.goal_info.goal_id.uuid):status.status
                    for status in message.status_list if status.status in (4,5,6)}
        for entry in list(self.requests.values()):
            handle = entry.get('handle')
            if entry.get('client') is not client or handle is None:
                continue
            status = terminal.get(bytes(handle.goal_id.uuid))
            if status is not None:
                entry['terminal_status'] = status
                if entry['cancel']:
                    self._retire_cancelled(entry)

    def cancel(self, entry):
        entry['cancel'] = True
        if entry.get('terminal_status') in (4,5,6):
            self._retire_cancelled(entry)
            return
        now = time.monotonic()
        if entry['handle'] and (not entry['cancel_sent'] or now-entry.get('cancel_sent_at',0.) >= 1.):
            attempt = object()
            entry['cancel_attempt'] = attempt
            pending = entry.get('cancel_future')
            if pending is not None and not pending.done():pending.cancel()
            entry['cancel_sent'] = True
            entry['cancel_sent_at'] = now
            f = entry['handle'].cancel_goal_async()
            entry['cancel_future'] = f
            def replied(future):
                if entry.get('cancel_attempt') is not attempt:return
                try:
                    reply = future.result()
                    if reply.return_code == 3:
                        self._retire_cancelled(entry)
                    elif reply.return_code != 0:
                        entry['cancel_sent'] = False
                except Exception:
                    entry['cancel_sent'] = False
            f.add_done_callback(replied)

    def plan_next_block(self):
        start, end = self.blocks[self.preflight_index]
        goal = ComputePathThroughPoses.Goal()
        goal.planner_id = self.planner_id
        goal.use_start = True
        goal.start = self.stamped(self.initial_pose if start == 0 else self.points[start-1].pose)
        goal.goals = [self.stamped(p.pose) for p in self.points[start:end]]
        self.submit(self.planner, goal, self.planned_block, 'plan')

    def planned_block(self, result):
        if not result.path.poses:
            raise RuntimeError('规划返回空路径')
        if not self.grid or time.monotonic()-self.grid[0]>3:
            raise RuntimeError('代价地图不新鲜，路线未启动')
        # ComputePathThroughPoses has validated the path against the planner's
        # current internal costmap. A separately published 1 Hz grid can be an
        # older revision and must not veto the new result.
        self.preview.poses.extend(result.path.poses)
        self.preflight_index += 1
        if self.preflight_index < len(self.blocks):
            self.plan_next_block()
            return
        self.preview.header.stamp = self.n.get_clock().now().to_msg()
        self.n.path_pub.publish(self.preview)
        self.n.preview_empty=False
        self.n.preview_state = 'ready'
        self.n.preview_effective_planner = self.planner_id
        self.n.preview_pose_count = len(self.preview.poses)
        self.n.preview_waypoint_count = len(self.points)
        if self.preflight_only:
            self.finish('preview_ready', '整条路线已通过静止规划检查；未发送导航目标')
        else:
            self.send_block()

    def make_tree(self):
        if self.strategy != "through_poses" and self.controller_id != "FollowPathMPPI":
            raise RuntimeError("整路有序跟踪当前仅支持已验证的 FollowPathMPPI；未发送运动目标")
        folder = Path.home()/'.local/share/omnifleet_t2/continuous-routes'
        folder.mkdir(parents=True, exist_ok=True)
        self.bt_file = folder/(self.run_id+f'-{self.block}.xml')
        if self.strategy == 'through_poses':
            # Share the single-goal selectors, replanning and recovery policy.
            template = (Path(get_package_share_directory('omnifleet_planner')) /
                        'behavior_trees/navigate_to_pose_with_selectors.xml').read_text()
            prefix = self.n.frame_id.rpartition('/')[0]
            base_frame = prefix+'/base_link' if prefix else 'base_link'
            self.bt_file.write_text(continuous_tree(
                template, self.n.frame_id, base_frame, self.radius))
            return str(self.bt_file)
        prefix = self.n.frame_id.rpartition('/')[0]
        base = prefix+'/base_link' if prefix else 'base_link'
        run = self.run_id+f'-{self.block}'
        text = f'''<root main_tree_to_execute="MainTree"><BehaviorTree ID="MainTree">
<ContinuousRouteControl goals="{{goals}}" path="{{path}}" pass_radius="{self.radius}" safety_horizon="2.0" allow_unknown="{str(self.allow_unknown).lower()}" global_frame={quoteattr(self.n.frame_id)} base_frame={quoteattr(base)} robot_prefix={quoteattr(prefix)} run_id={quoteattr(run)}>
<ComputePathThroughPoses goals="{{continuous_plan_goals}}" path="{{path}}" planner_id={quoteattr(self.planner_id)}/>
<FollowPath path="{{continuous_tracking_path}}" controller_id={quoteattr(self.controller_id)} goal_checker_id="continuous_goal_checker"/>
</ContinuousRouteControl></BehaviorTree></root>'''
        self.bt_file.write_text(text)
        return str(self.bt_file)

    def send_block(self):
        if self.strategy=='nav2_waypoints':
            self.backend_initializing=False
            goal=FollowWaypoints.Goal()
            self.n.current_job.native_dispatch_stamp=self.n.get_clock().now().nanoseconds
            goal.poses=[self.stamped(p.pose) for p in self.points]
            self.set_phase('tracking','Nav2 FollowWaypoints 正在执行整条固定航点路线')
            self.submit(self.waypoints,goal,self.waypoints_done,'navigation',self.waypoints_feedback)
            return
        self.backend_initializing = self.strategy not in ("single", "sequential", "through_poses") and not self.native_behavior_tree
        self.backend_init_started = time.monotonic()
        if self.backend_initializing:self.n.inhibit_output()
        if self.single_point or self.sequential:
            start, end = self.blocks[self.block]
            goal = NavigateToPose.Goal()
            goal.pose = self.stamped(self.points[start].pose)
            goal.behavior_tree = self.native_behavior_tree
            self.states[start] = '正在导航'
            self.set_phase('tracking', f'逐点导航：航点{start+1}/{len(self.points)} · {self.points[start].name}' if self.sequential else '本地单点导航执行中')
            self.submit(self.single, goal, self.block_done, 'navigation', self.n.navigation_feedback)
            return
        start, end = self.blocks[self.block]
        goal = NavigateThroughPoses.Goal()
        goal.poses = [self.stamped(p.pose) for p in self.points[start:end]]
        goal.behavior_tree = self.native_behavior_tree or self.make_tree()
        self.states[start] = '启动检查中'
        self.set_phase('tracking', f'Nav2连续导航：第{self.block+1}/{len(self.blocks)}段，航点{start+1}到{end}')
        self.submit(self.navigator, goal, self.block_done, 'navigation', self.through_feedback)

    def waypoints_feedback(self,message):
        index=int(message.feedback.current_waypoint)
        if not self.active or not 0<=index<len(self.states):return
        for i in range(index):self.states[i]='已通过'
        self.states[index]='正在导航';self.n.publish_catalog()

    def waypoints_done(self,result):
        if result.missed_waypoints:raise RuntimeError('Nav2 未完成航点：'+str(list(result.missed_waypoints)))
        self.block_done(result)

    def through_feedback(self, message):
        if self.active and self.phase == 'tracking':
            start, end = self.blocks[self.block]
            remaining = message.feedback.number_of_poses_remaining
            if 1 <= remaining <= end-start:
                for i in range(start, end-remaining):
                    self.states[i] = '已通过'
                self.states[end-remaining] = '正在通过'
                self.n.publish_catalog()
        self.n.navigation_feedback(message)

    def on_execution_state(self, message):
        if self.strategy in ('single', 'sequential', 'through_poses'):
            return
        try:
            value = json.loads(message.data)
            if value.get('run_id') != self.run_id+f'-{self.block}':
                return
            if value.get('state') == 'failed':
                reason = '连续导航失败：'+str(value.get('reason', '执行检查失败'))
                if self.active:
                    self.request_failed('navigation', reason)
                elif self.phase == 'failed':
                    self.cancel_reason = reason
                    self.n.publish_status(reason)
                return
            if not self.active or self.phase not in ('preplanning','tracking','replanning'):
                return
            if value.get('state')=='waiting_localization':
                self.n.inhibit_output()
                if not getattr(self,'initialization_announced',False):
                    self.initialization_announced=True
                    self.n.publish_status('连续段初始化：底盘保持停止，等待定位连续稳定')
                return
            if value.get('state')=='tracking' and getattr(self,'backend_initializing',False):
                # if not self.health.ready(time.time(),time.monotonic()):return
                self.backend_initializing=False;self.initialization_announced=False
                self.phase='tracking';self.n.arm_navigation_output()
                self.n.publish_status('连续段路径检查通过，开始连续路径跟踪')
            start, end = self.blocks[self.block]
            remaining = int(value['remaining'])
            if not 1 <= remaining <= end-start:
                return
            first = end-remaining
            for i in range(start, first):
                self.states[i] = '已通过'
            if self.phase in ('preplanning','tracking','replanning'):
                self.states[first] = '停靠对齐中' if first == end-1 else '正在通过'
                self.phase = value['state'] if value['state'] in ('tracking','replanning') else self.phase
                self.n.publish_catalog()
        except (ValueError, KeyError, TypeError):
            return

    def block_done(self, _result):
        start, end = self.blocks[self.block]
        for i in range(start, end-1):
            self.states[i] = '已通过'
        self.backend_initializing=False
        self.stop_since = None
        self.stop_deadline = time.monotonic()+5
        self.set_phase('stopping', '段末到点成功，确认底盘停止后开始停靠计时')
        if self.bt_file:
            self.bt_file.unlink(missing_ok=True)
            self.bt_file = None

    def resume_after_clearance(self):
        if self.requests or self.active:raise RuntimeError('旧导航请求尚未结束，不能恢复')
        start,end=self.blocks[self.block]
        while start<end-1 and self.states[start] in ('已通过','已停靠'):start+=1
        self.blocks[self.block]=(start,end)
        self.epoch+=1;self.failed=False;self.active=self.n.navigation_active=True
        if self.strategy in ('formation_follow','trail_follow'):
            stream=self.formation if self.strategy=='formation_follow' else self.follow
            sequence=stream.sequence
            stream.start(self.points)
            stream.sequence=sequence
            self.set_phase('tracking','动态协同导航恢复，等待当前会话的新目标')
            return
        self.send_block()

    def stop(self, reason, failed=False):
        if getattr(self,'strategy','')=='trail_follow':self.follow.stop()
        elif getattr(self,'strategy','')=='formation_follow':self.formation.stop()
        if not self.active:
            return
        if self.phase in ('canceling', 'cancel_unconfirmed'):
            # Cleanup/duplicate stop must not overwrite the original failure.
            if failed and not self.failed:
                self.failed, self.cancel_reason = True, reason
            for entry in list(self.requests.values()):
                self.cancel(entry)
            return
        self.cancel_reason = reason
        self.failed = failed
        self.epoch += 1
        self.configuration_pending = False
        self.cancel_deadline = time.monotonic()+5
        for entry in list(self.requests.values()):
            self.cancel(entry)
        self.set_phase('canceling', reason+'；正在取消全部相关请求')

    def finish(self, phase, text):
        self.active = self.n.navigation_active = False
        self.phase = phase
        if self.bt_file:
            self.bt_file.unlink(missing_ok=True)
            self.bt_file = None
        self.n.publish_status(text)
        self.n.publish_catalog()
        if self.n.preview_planner_id != getattr(self,'planner_id',self.n.preview_planner_id):
            self.n.request_route_preview()

    def tick(self):
        self.on_tf(None)
        now_mono = time.monotonic()
        # 已禁用：500ms 后清空规划位姿的间接门控。
        # if self.pose and now_mono - self.pose[0] > .5:
        #     self.pose = None
        # 保留最后一次规划位姿；TF 年龄在此仅用于诊断。
        fresh = self.health.check(time.time(), now_mono)
        self.tf_check_count += 1
        if self.tf_last_check_mono is not None:
            self.tf_max_check_interval_ms = max(self.tf_max_check_interval_ms, (now_mono-self.tf_last_check_mono)*1000.0)
        self.tf_last_check_mono = now_mono
        if self.health.age_ms is not None:
            self.tf_max_age_ms = max(self.tf_max_age_ms or self.health.age_ms, self.health.age_ms)
            if self.health.age_ms > 500.0:
                self.tf_over500_count += 1
        if not self.active:
            return
        now = time.monotonic()
        if self.configuration_pending and now > self.configuration_deadline:
            self.stop('读取规划配置超时，路线未启动', failed=True)
        for entry in list(self.requests.values()):
            if now > entry['deadline'] and not entry['cancel']:
                self.stop('请求超时，已要求取消；未确认取消前不会继续', failed=True)
                break
        if self.phase in ('canceling','cancel_unconfirmed'):
            self.zero.publish(Twist())
            for entry in list(self.requests.values()):
                self.cancel(entry)
            if not self.requests:
                self.finish('failed' if self.failed else 'canceled', self.cancel_reason+'；相关请求已结束')
            elif now > self.cancel_deadline and self.phase != 'cancel_unconfirmed':
                self.set_phase('cancel_unconfirmed', '取消未确认，已停止发后续段；请检查服务或重启导航栈')
            return
        if self.strategy=='formation_follow':
            self.formation.tick(now)
            return
        if self.strategy=='trail_follow':
            self.follow.tick(now)
            return
        # if getattr(self,'backend_initializing',False):
            # self.n.inhibit_output()
            # if now-self.backend_init_started>5:
                # self.stop('连续段初始化超时：定位或路径跟踪未就绪，未允许底盘运动',failed=True)
            # return
        # Disabled by explicit operator request: a stale MOLA pose/TF must not
        # hard-stop an otherwise accepted route. Existing emergency stop,
        # collision protection, speed limits, watchdog and output safety chain
        # remain active.
        # if not fresh or not self.pose or now-self.pose[0] > .5:
        #     self.stop(self.health.reason+'；MOLA位姿/TF不新鲜，停止路线', failed=True)
        #     return
        if self.phase in ('stopping','waiting'):
            self.zero.publish(Twist())
            stopped = self.odom and now-self.odom[0] < .4 and abs(self.odom[1].twist.twist.linear.x) < .02 and abs(self.odom[1].twist.twist.angular.z) < .05
            if self.phase == 'stopping':
                self.stop_since = (self.stop_since or now) if stopped else None
                if self.stop_since and now-self.stop_since >= .3:
                    start, end = self.blocks[self.block]
                    self.states[end-1] = '等待中'
                    dwell = self.points[end-1].dwell_seconds if not self.sequential or self.points[end-1].kind == "stop" else 0.
                    self.wait_until = now+dwell
                    self.set_phase('waiting', f'航点{end}已停稳，等待{dwell:g}秒')
                elif now > self.stop_deadline:
                    self.stop('段末未确认底盘停止', failed=True)
            elif not stopped:
                self.stop('停靠期间底盘反馈不满足停止条件', failed=True)
            elif now >= self.wait_until:
                _, end = self.blocks[self.block]
                self.states[end-1] = '已停靠'
                self.block += 1
                if self.block == len(self.blocks):
                    self.finish('completed', '逐点导航完成：所有航点均已到达并停稳' if self.sequential else '整条路线完成：途经点已通过，停靠点及最终点已完成')
                else:
                    self.send_block()
            elif now-getattr(self, 'last_wait_report', 0.) >= .25:
                self.last_wait_report = now
                self.n.publish_catalog()
