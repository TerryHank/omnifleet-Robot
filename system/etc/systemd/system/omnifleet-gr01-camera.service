[Unit]
Description=OmniFleet GR01 RGB RTSP camera
After=NetworkManager.service omnifleet-t2-rgbd-camera.service

[Service]
User=iecme
WorkingDirectory=/home/iecme/orbbec345lg-v2.10.6
ExecStart=/bin/bash /home/iecme/orbbec345lg-v2.10.6/gr01_rtsp.bash
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
