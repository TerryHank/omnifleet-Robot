[Unit]
Description=OmniFleet A2 Foxglove heavy debug bridge
Wants=network-online.target
After=network-online.target
Conflicts=omnifleet-a2-foxglove-bridge.service

[Service]
Type=simple
User=iecme
Group=iecme
WorkingDirectory=/home/iecme/omnifleet_a2_ws
Environment=HOME=/home/iecme
Environment=ROS_HOME=/var/lib/omnifleet_a2/ros
EnvironmentFile=/etc/omnifleet_a2/robot.env
ExecStart=/bin/bash -lc 'source /opt/ros/$ROS_DISTRO/setup.bash && source $OMNIFLEET_A2_SENSOR_WS/install/setup.bash && source $OMNIFLEET_A2_WS/install/setup.bash && exec ros2 run foxglove_bridge foxglove_bridge --ros-args -r __node:=omnifleet_a2_foxglove_heavy --params-file /etc/omnifleet_a2/foxglove_heavy.yaml -p address:=$OMNIFLEET_A2_FOXGLOVE_ADDRESS -p port:=$OMNIFLEET_A2_FOXGLOVE_HEAVY_PORT'
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=15
UMask=0007

[Install]
WantedBy=multi-user.target
