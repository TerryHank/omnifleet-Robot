[Unit]
Description=OmniFleet T2 Foxglove WebSocket bridge
After=network-online.target

[Service]
Type=simple
User=iecme
Group=iecme
WorkingDirectory=/home/iecme/omnifleet_ws
Environment=HOME=/home/iecme
EnvironmentFile=/etc/omnifleet_t2/robot.env
ExecStart=/bin/bash -lc 'source /home/iecme/omnifleet_ws/src/system/workspace_support/robot_fleet_env.bash && exec ros2 run foxglove_bridge foxglove_bridge --ros-args -r __node:=omnifleet_t2_foxglove_bridge --params-file /etc/omnifleet_t2/foxglove.yaml -p address:=$OMNIFLEET_T2_FOXGLOVE_ADDRESS -p port:=$OMNIFLEET_T2_FOXGLOVE_PORT'
Restart=always
RestartSec=2
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
