[Unit]
Description=OmniFleet independent onboard navigation and sole chassis output
After=omnifleet-t2-zenoh-router.service
Before=omnifleet-t2-chassis.service

[Service]
Type=simple
User=iecme
Group=iecme
Environment=HOME=/home/iecme
WorkingDirectory=/home/iecme/omnifleet_ws
ExecStart=/bin/bash -c 'source /home/iecme/omnifleet_ws/src/system/workspace_support/robot_fleet_env.bash; exec ros2 run omnifleet_local_navigation local_navigation --config /home/iecme/omnifleet_ws/src/control/omnifleet_local_navigation/config/local-navigation.json'
Restart=on-failure
RestartSec=1
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
