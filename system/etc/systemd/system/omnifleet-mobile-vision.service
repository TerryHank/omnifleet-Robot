[Unit]
Description=OmniFleet mobile object recognition
After=omnifleet-t2-rgbd-camera.service
[Service]
User=iecme
Environment=HOME=/home/iecme
Environment=ROS_DOMAIN_ID=101
Environment=ZENOH_CONFIG_OVERRIDE="transport/shared_memory/enabled=false;transport/shared_memory/transport_optimization/enabled=false"
ExecStart=/bin/bash -lc 'source /home/iecme/omnifleet_ws/env.bash; exec python3 /opt/omnifleet-mobile-vision/mobile_vision.py'
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
[Install]
WantedBy=multi-user.target
