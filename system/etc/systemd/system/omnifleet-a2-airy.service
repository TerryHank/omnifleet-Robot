[Unit]
Description=OmniFleet A2 RoboSense Airy driver
Wants=network-online.target
After=network-online.target NetworkManager.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=iecme
Group=iecme
WorkingDirectory=/home/iecme/omnifleet_a2_ws
Environment=HOME=/home/iecme
Environment=ROS_HOME=/var/lib/omnifleet_a2/ros
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/omnifleet_a2/robot.env
ExecStart=/bin/bash -lc 'set -e && source /opt/ros/$ROS_DISTRO/setup.bash && source $OMNIFLEET_A2_SENSOR_WS/install/setup.bash && source $OMNIFLEET_A2_WS/install/setup.bash && exec ros2 launch omnifleet_a2_localization airy_gateway.launch.py'
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=20
Restart=on-failure
RestartSec=3
UMask=0007

[Install]
WantedBy=multi-user.target
