[Unit]
Description=OmniFleet A2 Nav2 only (start MOLA first)
Wants=network-online.target omnifleet-a2-airy.service omnifleet-a2-chassis.service
After=network-online.target omnifleet-a2-airy.service omnifleet-a2-chassis.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=iecme
Group=iecme
WorkingDirectory=/home/iecme/omnifleet_a2_ws
Environment=HOME=/home/iecme
Environment=ROS_HOME=/var/lib/omnifleet_a2/ros
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/omnifleet_a2/robot.env
ExecStart=/bin/bash -lc 'set -e && source /opt/ros/$ROS_DISTRO/setup.bash && source $OMNIFLEET_A2_SENSOR_WS/install/setup.bash && source $OMNIFLEET_A2_WS/install/setup.bash && exec ros2 launch omnifleet_a2_bringup production_nav2.launch.py planner_mode:=hybrid_astar controller_mode:=rpp'
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
UMask=0007

[Install]
WantedBy=multi-user.target
