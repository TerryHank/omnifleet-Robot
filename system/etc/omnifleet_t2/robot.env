ROS_DISTRO=humble
ROS_DOMAIN_ID=101
OMNIFLEET_T2_WS=/home/iecme/omnifleet_ws
OMNIFLEET_T2_SENSOR_WS=/home/iecme/omnifleet_ws
OMNIFLEET_T2_SERIAL_PORT=/dev/omnifleet_t2_stm32
OMNIFLEET_T2_FOXGLOVE_ADDRESS=0.0.0.0
OMNIFLEET_T2_FOXGLOVE_PORT=8765
OMNIFLEET_T2_MAP_DIR=/home/iecme/omnifleet_data/maps
OMNIFLEET_ROBOT_ID=robot_101
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ROS_LOCALHOST_ONLY=0

# This vehicle uses its own RGB sensor topic.
OMNIFLEET_CAMERA_COLOR_TOPIC=/camera/color/image_raw
OMNIFLEET_CAMERA_DEPTH_TOPIC=/camera/aligned_depth_to_color/image_raw
OMNIFLEET_LIDAR_POINTS_TOPIC=/rslidar_points

FASTRTPS_DEFAULT_PROFILES_FILE=/etc/omnifleet_t2/fastdds-local.xml
RMW_FASTRTPS_USE_QOS_FROM_XML=1
OMNIFLEET_DDS_DISCOVERY_PORT=42100
OMNIFLEET_CHASSIS_MODEL=ranger_mini_v3
